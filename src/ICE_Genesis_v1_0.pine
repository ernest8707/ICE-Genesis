//@version=6
indicator(
     "ICE Genesis v1.0 - Zig Zag PR3",
shorttitle = "ICEGen",     overlay = true,
     max_labels_count = 250,
     max_lines_count = 200,
     max_boxes_count = 100
)

//------------------------------------------------------------------------------
// IMPORTANT
// v1.0 Alpha 3 foundation:
// - The Alpha 2 liquidity engine is preserved.
// - BOS and CHoCH rendering is rebuilt for immediate chart readability.
// - Structure lines begin at the broken swing and extend beyond the break candle.
// - Internal and external events receive separate visual strength and history controls.
// - Tiny labels sit directly on their dashed structure line without label boxes.
//
// ICE Genesis is a rules-based approximation of ICT/SMC concepts.
// It does not predict price and should be validated with replay/backtesting.
//------------------------------------------------------------------------------

//=============================================================================
// 1. INPUTS
//=============================================================================
groupCore      = "1. Core"
groupBias      = "2. Higher-Timeframe Bias"
groupStructure = "3. Structure"
groupLiquidity = "4. Liquidity"
groupDisp      = "5. Displacement"
groupZones     = "6. Order Block / FVG"
groupTime      = "7. Time Alignment"
groupRisk      = "8. Trade Plan"
groupVisual    = "9. Visuals"
groupDashboard = "10. Adaptive Dashboard"
groupInstitutionalBias = "11. Institutional Bias"
groupExecution = "12. Execution Engine"
groupSniper    = "13. Sniper Model Engine"
groupZigZag    = "14. Zig Zag Market Structure"
showDashboard = input.bool(true, "Show dashboard", group = groupCore)
dashboardMode = input.string("Execution", "Dashboard mode", options = ["Full", "Morning Brief", "Execution", "Trade Management", "Compact", "Minimal", "Off"], group = groupDashboard)
enableInstitutionalBias = input.bool(
     true,
     "Enable Institutional Bias Engine",
     group = groupInstitutionalBias
)

anchorBiasTimeframe = input.timeframe(
     "D",
     "Anchor Bias Timeframe",
     group = groupInstitutionalBias
)

trendBiasTimeframe = input.timeframe(
     "240",
     "Trend Bias Timeframe",
     group = groupInstitutionalBias
)

executionBiasTimeframe = input.timeframe(
     "60",
     "Execution Bias Timeframe",
     group = groupInstitutionalBias
)

requireAnchorAlignment = input.bool(
     true,
     "Require Anchor Bias Alignment",
     group = groupInstitutionalBias
)

requireTrendAlignment = input.bool(
     true,
     "Require Trend Bias Alignment",
     group = groupInstitutionalBias
)

requireExecutionAlignment = input.bool(
     true,
     "Require Execution Bias Alignment",
     group = groupInstitutionalBias
)

allowCountertrendSetups = input.bool(
     false,
     "Allow Countertrend Setups",
     group = groupInstitutionalBias
)

countertrendScorePenalty = input.int(
     30,
     "Countertrend Score Penalty",
     minval = 0,
     maxval = 100,
     step = 5,
     group = groupInstitutionalBias
)

showBiasDebug = input.bool(
    false,
    "Show Bias Debug Values",
    group = groupInstitutionalBias
)

executionRetestMemoryBars = input.int(
     12,
     "Retest memory bars",
     minval = 1,
     maxval = 100,
     group = groupExecution
)

showExecutionDebug = input.bool(
     false,
     "Show Execution Debug Values",
     group = groupExecution
)

showExecutionRetestMarkers = input.bool(
     true,
     "Show retest markers",
     group = groupExecution
)

showExecutionConfirmationMarkers = input.bool(
     true,
     "Show confirmation markers",
     group = groupExecution
)

executionMarkerCooldownBars = input.int(
     8,
     "Execution marker cooldown bars",
     minval = 0,
     maxval = 100,
     group = groupExecution
)

executionMarkersOncePerZone = input.bool(
     true,
     "Only show first execution marker per zone",
     group = groupExecution
)

entryTriggerLockEnabled = input.bool(
     true,
     "Lock first entry trigger per zone",
     group = groupExecution
)

showExecutionEntryTriggerMarkers = input.bool(
     true,
     "Show entry trigger markers",
     group = groupExecution
)

requireConfirmationBreakForEntry = input.bool(
     true,
     "Require confirmation candle break for entry trigger",
     group = groupExecution
)

entryTriggerBreakMode = input.string(
     "Wick Break",
     "Entry trigger break mode",
     options = ["Wick Break", "Close Break"],
     group = groupExecution
)

confirmationBreakMemoryBars = input.int(
     5,
     "Confirmation break memory bars",
     minval = 1,
     maxval = 50,
     group = groupExecution
)

enableSniperModel = input.bool(
     true,
     "Enable Sniper Model Engine",
     group = groupSniper
)

showSniperDebug = input.bool(
     false,
     "Show Sniper Debug Values",
     group = groupSniper
)

showSniperProtectedLevels = input.bool(
     false,
     "Show protected high / low",
     group = groupSniper
)

protectedLevelBreakMode = input.string(
     "Wick Sweep",
     "Protected level break mode",
     options = ["Wick Sweep", "Close Break"],
     group = groupSniper
)

sniperInternalSweepMemoryBars = input.int(
     12,
     "Internal sweep memory bars",
     minval = 1,
     maxval = 100,
     group = groupSniper
)

sniperHTFContextMemoryBars = input.int(
     24,
     "HTF context memory bars",
     minval = 1,
     maxval = 200,
     group = groupSniper
)

sniperRequireHTFBiasForContext = input.bool(
     true,
     "Require HTF bias for sniper context",
     group = groupSniper
)

minimumScore    = input.int(75, "Minimum setup score", minval = 0, maxval = 100, step = 5, group = groupCore)
minimumScoreSeparation = input.int(15, "Minimum bull / bear score separation", minval = 0, maxval = 50, step = 5, group = groupCore)
requireOTEForDecision = input.bool(false, "Require OTE for BUY / SELL", group = groupCore)
requireHTFForDecision = input.bool(false, "Require HTF alignment for BUY / SELL", group = groupCore)
maxLabels       = input.int(14, "Maximum structure labels", minval = 2, maxval = 50, group = groupCore)
maxLiquidityMarks = input.int(4, "Maximum liquidity marks", minval = 1, maxval = 20, group = groupCore)

biasTimeframe   = input.timeframe("240", "Primary bias timeframe", group = groupBias)
confirmTimeframe = input.timeframe("60", "Confirmation timeframe", group = groupBias)
biasMode        = input.string("EMA + Structure", "Bias method",
     options = ["EMA", "Structure", "EMA + Structure"], group = groupBias)
showHTFLevels   = input.bool(false, "Show HTF protected levels", group = groupBias)

internalLen     = input.int(3, "Internal swing strength", minval = 2, maxval = 20, group = groupStructure)
externalLen     = input.int(8, "External swing strength", minval = 3, maxval = 50, group = groupStructure)
requireCloseBreak = input.bool(true, "Require candle close through structure", group = groupStructure)
requireDisplacementForStructure = input.bool(true, "Require displacement on structure breaks", group = groupStructure)
requireSweepBeforeMSS = input.bool(true, "Require liquidity sweep before MSS / CHoCH", group = groupStructure)
requireSweepBeforeBOS = input.bool(true, "Require liquidity sweep before BOS", group = groupStructure)
useInternalSweepGate = input.bool(true, "Include internal liquidity sweeps", group = groupStructure)
sweepToBreakBars = input.int(24, "Maximum bars from sweep to MSS/BOS", minval = 1, maxval = 200, group = groupStructure)
showInternalEvents = input.bool(true, "Show internal BOS / MSS", group = groupStructure)
showExternalEvents = input.bool(true, "Show external BOS", group = groupStructure)

showPDLevels    = input.bool(false, "Show previous-day high / low", group = groupLiquidity)
showPWLevels    = input.bool(false, "Show previous-week high / low", group = groupLiquidity)
showSweepMarks  = input.bool(true, "Show completed liquidity sweeps", group = groupLiquidity)
showInternalLiquidity = input.bool(true, "Track internal BSL / SSL", group = groupLiquidity)
showExternalLiquidity = input.bool(true, "Track external BSL / SSL", group = groupLiquidity)
useEqualLiquidity = input.bool(true, "Track persistent EQH / EQL", group = groupLiquidity)
equalToleranceATR = input.float(0.10, "Equal-level tolerance × ATR", minval = 0.01, step = 0.01, group = groupLiquidity)
liquiditySweepMode = input.string("Wick Rejection", "Sweep confirmation", options = ["Wick Rejection", "Any Trade Through"], group = groupLiquidity)
showUntouchedEqualLevels = input.bool(false, "Show untouched EQH / EQL", group = groupLiquidity)
maxEqualLevels = input.int(6, "Maximum active EQH / EQL levels", minval = 1, maxval = 20, group = groupLiquidity)

atrLength       = input.int(14, "ATR length", minval = 1, group = groupDisp)
bodyATR         = input.float(0.65, "Minimum body × ATR", minval = 0.10, step = 0.05, group = groupDisp)
bodyPercentMin  = input.float(60.0, "Minimum body % of candle range", minval = 10, maxval = 100, step = 5, group = groupDisp)
requireFVGOnDisplacement = input.bool(true, "Require FVG with displacement", group = groupDisp)
displacementMemoryBars = input.int(12, "Remember displacement for dashboard (bars)", minval = 1, maxval = 100, group = groupDisp)

showOrderBlock  = input.bool(true, "Show validated order-block zones", group = groupZones)
showFVG         = input.bool(true, "Show newest qualified FVG", group = groupZones)
fvgLabelMode = input.string(
     "None",
     "FVG Label Mode",
     options = ["Full", "Short", "None"],
     group = groupZones
)
maxOBZones      = input.int(6, "Maximum visible order-block zones", minval = 1, maxval = 20, group = groupZones)
obZoneOpacity   = input.int(88, "Order-block fill transparency", minval = 50, maxval = 95, group = groupZones)
obBorderWidth   = input.int(1, "Order-block border width", minval = 1, maxval = 4, group = groupZones)
showOBPriceText = input.bool(false, "Show OB type and price range inside zone", group = groupZones)
orderBlockLabelMode = input.string(
     "None",
     "Order Block Label Mode",
     options = ["Full", "Short", "None"],
     group = groupZones
)
obSearchBars    = input.int(12, "Search back for order-block candle", minval = 2, maxval = 50, group = groupZones)
useBodyForOB    = input.bool(false, "Use candle body for OB boundaries", group = groupZones)
deleteMitigated = input.bool(true, "Delete mitigated zones", group = groupZones)
requireFVGForSetup = input.bool(true, "Require FVG for qualified setup", group = groupZones)
requireOBFVGOverlap = input.bool(true, "Require order block / FVG overlap", group = groupZones)
obMitigationMode = input.string("Touch", "Order-block mitigation method",
     options = ["Touch", "Midpoint", "Full"], group = groupZones)

useSessionFilter = input.bool(true, "Use session filter", group = groupTime)
tradeSession     = input.session("0930-1130", "Trading window", group = groupTime)
sessionTimezone  = input.string("America/New_York", "Session timezone",
     options = ["America/New_York", "America/Chicago", "Etc/UTC"], group = groupTime)

showTradePlan   = input.bool(true, "Show entry / stop / target", group = groupRisk)
entryMode       = input.string("OB Midpoint", "Entry method",
     options = ["OB Proximal", "OB Midpoint", "FVG Midpoint"], group = groupRisk)
stopBufferATR   = input.float(0.10, "Stop buffer × ATR", minval = 0.0, step = 0.05, group = groupRisk)
targetRR        = input.float(2.0, "Target risk/reward", minval = 0.5, step = 0.25, group = groupRisk)

showEMAs        = input.bool(true, "Show 20 / 50 / 200 EMAs", group = groupVisual)
showSetupArrows = input.bool(true, "Show qualified setup arrows", group = groupVisual)
showBiasTint    = input.bool(false, "Show subtle bias background", group = groupVisual)
showStructureLines = input.bool(true, "Show dashed BOS / CHoCH lines", group = groupVisual)
internalStructureLineBars = input.int(30, "Internal lookback length (bars)", minval = 3, maxval = 200, group = groupVisual)
externalStructureLineBars = input.int(90, "External lookback length (bars)", minval = 3, maxval = 400, group = groupVisual)
structureForwardBars = input.int(18, "Extend structure line past break (bars)", minval = 0, maxval = 100, group = groupVisual)
structureLineWidth = input.int(1, "Structure-line width", minval = 1, maxval = 3, group = groupVisual)
anchorStructureAtSwing = input.bool(true, "Anchor structure line at broken swing", group = groupVisual)
structureLabelPosition = input.string("Near break", "Structure text position", options = ["Centered", "Near break"], group = groupVisual)
fadeInternalStructure = input.bool(true, "Fade internal structure events", group = groupVisual)
showSessionShading = input.bool(false, "Show Asia / London / New York shading", group = groupVisual)
visualMode = input.string("Trading", "Visual mode", options = ["Study", "Trading", "Minimal"], group = groupVisual)
showLiquidityLines = input.bool(true, "Show liquidity labels with dashed lines", group = groupVisual)
liquidityLineBars = input.int(10, "Liquidity-line length (bars)", minval = 3, maxval = 50, group = groupVisual)
liquidityLabelCooldownBars = input.int(
     8,
     "Liquidity label cooldown bars",
     minval = 0,
     maxval = 100,
     group = groupVisual
)
liquidityLabelPriceSpacingATR = input.float(
     0.20,
     "Liquidity label price spacing × ATR",
     minval = 0.0,
     step = 0.05,
     group = groupVisual
)
liquidityLabelsRequireOBContext = input.bool(
     true,
     "Only show liquidity labels with OB context",
     group = groupVisual
)
liquidityLabelOBProximityATR = input.float(
     1.00,
     "Liquidity label OB proximity × ATR",
     minval = 0.0,
     step = 0.25,
     group = groupVisual
)
chartLabelMode = input.string(
     "Minimal",
     "Chart Label Mode",
     options = ["Full", "Short", "Minimal"],
     group = groupVisual
)

showZigZag = input.bool(
     true,
     "Show Zig Zag",
     group = groupZigZag
)

zigZagSwingSource = input.string(
     "External",
     "Zig Zag swing source",
     options = ["Internal", "External"],
     group = groupZigZag
)

showZigZagLabels = input.bool(
     true,
     "Show Zig Zag price labels",
     group = groupZigZag
)

zigZagLabelMode = input.string(
     "Short",
     "Zig Zag label style",
     options = ["Full", "Short", "Off"],
     group = groupZigZag
)

maxZigZagLegs = input.int(
     12,
     "Maximum Zig Zag legs",
     minval = 2,
     maxval = 50,
     group = groupZigZag
)

zigZagLineWidth = input.int(
     2,
     "Zig Zag line thickness",
     minval = 1,
     maxval = 4,
     group = groupZigZag
)

zigZagPriceLabelOffsetATR = input.float(
     0.12,
     "Zig Zag price label offset × ATR",
     minval = 0.0,
     maxval = 1.0,
     step = 0.01,
     group = groupZigZag
)

showSmartTradePanel = input.bool(true, "Show smart trade planner in dashboard", group = groupVisual)
asiaSession = input.session("1900-0200", "Asia session", group = groupTime)
londonSession = input.session("0200-0500", "London session", group = groupTime)
newYorkSession = input.session("0830-1100", "New York session", group = groupTime)

//=============================================================================
// 2. COLORS
//=============================================================================
bullColor    = color.rgb(35, 180, 105)
bearColor    = color.rgb(225, 75, 75)
neutralColor = color.rgb(145, 150, 160)
liqColor     = color.rgb(235, 180, 45)
fvgColor     = color.rgb(70, 145, 235)
panelColor   = color.new(color.rgb(18, 22, 30), 5)
chochBullColor = color.aqua
chochBearColor = color.orange
asiaShade = color.new(color.rgb(176, 132, 32), 91)
londonShade = color.new(color.rgb(35, 95, 180), 91)
newYorkShade = color.new(color.rgb(130, 70, 170), 91)

//=============================================================================
// 2A. CHART READABILITY LABEL TEXT — PR9 / ZIG ZAG PR3
// Centralized label text for Full / Short / Minimal chart display modes.
// Zig Zag PR3 preserves price-label cleanup and adds trend classification.
//=============================================================================
labelModeFull = chartLabelMode == "Full"
labelModeShort = chartLabelMode == "Short"
labelModeMinimal = chartLabelMode == "Minimal"

labelBSLTaken = labelModeFull ? "BSL  Taken ✓" : labelModeShort ? "BSL ✓" : "BSL"
labelSSLTaken = labelModeFull ? "SSL  Taken ✓" : labelModeShort ? "SSL ✓" : "SSL"
labelEQHTaken = labelModeFull ? "EQH  Taken ✓" : labelModeShort ? "EQH ✓" : "EQH"
labelEQLTaken = labelModeFull ? "EQL  Taken ✓" : labelModeShort ? "EQL ✓" : "EQL"

labelEQHUntouched = labelModeFull ? "EQH  Untouched" : labelModeShort ? "EQH" : "EQH"
labelEQLUntouched = labelModeFull ? "EQL  Untouched" : labelModeShort ? "EQL" : "EQL"

labelBullBOS = labelModeFull ? "Bullish BOS" : labelModeShort ? "BOS ↑" : "BOS"
labelBearBOS = labelModeFull ? "Bearish BOS" : labelModeShort ? "BOS ↓" : "BOS"
labelBullCHoCH = labelModeFull ? "Bullish CHoCH" : labelModeShort ? "CH ↑" : "CH"
labelBearCHoCH = labelModeFull ? "Bearish CHoCH" : labelModeShort ? "CH ↓" : "CH"

labelRetest = labelModeFull ? "RT" : labelModeShort ? "RT" : "R"
labelConfirmation = labelModeFull ? "CONF" : labelModeShort ? "CNF" : "C"
labelEntryTrigger = labelModeFull ? "TRIGGER" : labelModeShort ? "TRG" : "T"

obLabelModeFull = orderBlockLabelMode == "Full"
obLabelModeShort = orderBlockLabelMode == "Short"
obLabelModeNone = orderBlockLabelMode == "None"

fvgLabelModeFull = fvgLabelMode == "Full"
fvgLabelModeShort = fvgLabelMode == "Short"
fvgLabelModeNone = fvgLabelMode == "None"

//=============================================================================
// 3. CURRENT-TIMEFRAME EMA CONTEXT
//=============================================================================
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

plot(showEMAs ? ema20 : na, "EMA 20", color = color.green, linewidth = 1)
plot(showEMAs ? ema50 : na, "EMA 50", color = color.orange, linewidth = 1)
plot(showEMAs ? ema200 : na, "EMA 200", color = color.purple, linewidth = 2)

//=============================================================================
// 3A. INSTITUTIONAL BIAS ENGINE — CONFIRMED TIMEFRAME DATA
// Uses only completed candles to prevent higher-timeframe repainting.
//=============================================================================
anchorClose = request.security(
     syminfo.tickerid,
     anchorBiasTimeframe,
     close[1],
     barmerge.gaps_off,
     barmerge.lookahead_on
)

trendClose = request.security(
     syminfo.tickerid,
     trendBiasTimeframe,
     close[1],
     barmerge.gaps_off,
     barmerge.lookahead_on
)

executionClose = request.security(
     syminfo.tickerid,
     executionBiasTimeframe,
     close[1],
     barmerge.gaps_off,
     barmerge.lookahead_on
)

// Temporary verification values. These appear only in TradingView's Data Window.
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showBiasDebug ? anchorClose : na, "Anchor Bias Confirmed Close", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showBiasDebug ? trendClose : na, "Trend Bias Confirmed Close", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showBiasDebug ? executionClose : na, "Execution Bias Confirmed Close", display = display.data_window)

//=============================================================================
// 4. HIGHER-TIMEFRAME BIAS
// Non-repainting request.security values from completed HTF candles.
//=============================================================================
htfClose = request.security(syminfo.tickerid, biasTimeframe, close[1], barmerge.gaps_off, barmerge.lookahead_on)
htfEma20 = request.security(syminfo.tickerid, biasTimeframe, ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfEma50 = request.security(syminfo.tickerid, biasTimeframe, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfEma200 = request.security(syminfo.tickerid, biasTimeframe, ta.ema(close, 200)[1], barmerge.gaps_off, barmerge.lookahead_on)

ctfClose = request.security(syminfo.tickerid, confirmTimeframe, close[1], barmerge.gaps_off, barmerge.lookahead_on)
ctfEma20 = request.security(syminfo.tickerid, confirmTimeframe, ta.ema(close, 20)[1], barmerge.gaps_off, barmerge.lookahead_on)
ctfEma50 = request.security(syminfo.tickerid, confirmTimeframe, ta.ema(close, 50)[1], barmerge.gaps_off, barmerge.lookahead_on)
ctfEma200 = request.security(syminfo.tickerid, confirmTimeframe, ta.ema(close, 200)[1], barmerge.gaps_off, barmerge.lookahead_on)

htfEmaBull = htfEma20 > htfEma50 and htfEma50 > htfEma200 and htfClose > htfEma20
htfEmaBear = htfEma20 < htfEma50 and htfEma50 < htfEma200 and htfClose < htfEma20
ctfEmaBull = ctfEma20 > ctfEma50 and ctfEma50 > ctfEma200 and ctfClose > ctfEma20
ctfEmaBear = ctfEma20 < ctfEma50 and ctfEma50 < ctfEma200 and ctfClose < ctfEma20

// Simple HTF structure proxy using confirmed pivots.
htfPH = request.security(syminfo.tickerid, biasTimeframe, ta.pivothigh(high, externalLen, externalLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfPL = request.security(syminfo.tickerid, biasTimeframe, ta.pivotlow(low, externalLen, externalLen)[1], barmerge.gaps_off, barmerge.lookahead_on)

var float htfProtectedHigh = na
var float htfProtectedLow = na
var int htfStructure = 0

if not na(htfPH)
    htfProtectedHigh := htfPH
if not na(htfPL)
    htfProtectedLow := htfPL

if not na(htfProtectedHigh) and htfClose > htfProtectedHigh
    htfStructure := 1
if not na(htfProtectedLow) and htfClose < htfProtectedLow
    htfStructure := -1

htfStructureBull = htfStructure == 1
htfStructureBear = htfStructure == -1

bullBias = biasMode == "EMA" ? (htfEmaBull and ctfEmaBull) :
     biasMode == "Structure" ? htfStructureBull :
     (htfEmaBull and ctfEmaBull and htfStructureBull)

bearBias = biasMode == "EMA" ? (htfEmaBear and ctfEmaBear) :
     biasMode == "Structure" ? htfStructureBear :
     (htfEmaBear and ctfEmaBear and htfStructureBear)

biasText = bullBias ? "Bullish" : bearBias ? "Bearish" : "Mixed"
bgcolor(showBiasTint ? (bullBias ? color.new(bullColor, 94) : bearBias ? color.new(bearColor, 94) : na) : na)

//=============================================================================
// 5. SESSION + DISPLACEMENT
//=============================================================================
inSession = not na(time(timeframe.period, tradeSession, sessionTimezone))
sessionAllowed = not useSessionFilter or inSession
inAsia = not na(time(timeframe.period, asiaSession, sessionTimezone))
inLondon = not na(time(timeframe.period, londonSession, sessionTimezone))
inNewYork = not na(time(timeframe.period, newYorkSession, sessionTimezone))
activeSessionText = inNewYork ? "New York" : inLondon ? "London" : inAsia ? "Asia" : "Inactive"
bgcolor(showSessionShading and visualMode == "Study" ? (inAsia ? asiaShade : inLondon ? londonShade : inNewYork ? newYorkShade : na) : na)

atr = ta.atr(atrLength)
rangeNow = math.max(high - low, syminfo.mintick)
bodyNow = math.abs(close - open)
bodyPct = bodyNow / rangeNow * 100.0

bullFVGNow = bar_index >= 2 and low > high[2]
bearFVGNow = bar_index >= 2 and high < low[2]

bullDisplacement = close > open and bodyNow >= atr * bodyATR and bodyPct >= bodyPercentMin and
     (not requireFVGOnDisplacement or bullFVGNow)
bearDisplacement = close < open and bodyNow >= atr * bodyATR and bodyPct >= bodyPercentMin and
     (not requireFVGOnDisplacement or bearFVGNow)

var int lastBullDisplacementBar = na
var int lastBearDisplacementBar = na
if bullDisplacement
    lastBullDisplacementBar := bar_index
if bearDisplacement
    lastBearDisplacementBar := bar_index
recentBullDisplacement = not na(lastBullDisplacementBar) and bar_index - lastBullDisplacementBar <= displacementMemoryBars
recentBearDisplacement = not na(lastBearDisplacementBar) and bar_index - lastBearDisplacementBar <= displacementMemoryBars

//=============================================================================
// 6. MARKET STRUCTURE ENGINE 2.0 — SWING REGISTRY
// Confirmed pivots are stored once, armed once, and consumed once.
// This keeps detection separate from classification and rendering.
//=============================================================================
intPH = ta.pivothigh(high, internalLen, internalLen)
intPL = ta.pivotlow(low, internalLen, internalLen)
extPH = ta.pivothigh(high, externalLen, externalLen)
extPL = ta.pivotlow(low, externalLen, externalLen)

var float lastIntHigh = na
var float lastIntLow = na
var int lastIntHighBar = na
var int lastIntLowBar = na
var bool intHighArmed = false
var bool intLowArmed = false

var float lastExtHigh = na
var float lastExtLow = na
var int lastExtHighBar = na
var int lastExtLowBar = na
var bool extHighArmed = false
var bool extLowArmed = false

if not na(intPH)
    lastIntHigh := intPH
    lastIntHighBar := bar_index - internalLen
    intHighArmed := true
if not na(intPL)
    lastIntLow := intPL
    lastIntLowBar := bar_index - internalLen
    intLowArmed := true
if not na(extPH)
    lastExtHigh := extPH
    lastExtHighBar := bar_index - externalLen
    extHighArmed := true
if not na(extPL)
    lastExtLow := extPL
    lastExtLowBar := bar_index - externalLen
    extLowArmed := true

breakAbove(float level) =>
    not na(level) and (requireCloseBreak ? close > level and close[1] <= level : high > level and high[1] <= level)

breakBelow(float level) =>
    not na(level) and (requireCloseBreak ? close < level and close[1] >= level : low < level and low[1] >= level)

// Raw events answer only one question: did price break this armed swing?
internalBullBreakRaw = intHighArmed and breakAbove(lastIntHigh)
internalBearBreakRaw = intLowArmed and breakBelow(lastIntLow)
externalBullBreakRaw = extHighArmed and breakAbove(lastExtHigh)
externalBearBreakRaw = extLowArmed and breakBelow(lastExtLow)

//=============================================================================
// 7. MODULAR LIQUIDITY ENGINE
// Persistent sources: internal/external swings, PDH/PDL, PWH/PWL and EQH/EQL.
//=============================================================================
pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_off, barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_off, barmerge.lookahead_on)

plot(showPDLevels ? pdh : na, "PDH", color = color.new(liqColor, 35), style = plot.style_linebr)
plot(showPDLevels ? pdl : na, "PDL", color = color.new(liqColor, 35), style = plot.style_linebr)
plot(showPWLevels ? pwh : na, "PWH", color = color.new(liqColor, 60), style = plot.style_linebr)
plot(showPWLevels ? pwl : na, "PWL", color = color.new(liqColor, 60), style = plot.style_linebr)

sweepHigh(float level) =>
    not na(level) and high > level and (liquiditySweepMode == "Any Trade Through" or close < level)

sweepLow(float level) =>
    not na(level) and low < level and (liquiditySweepMode == "Any Trade Through" or close > level)

internalBSLSweep = showInternalLiquidity and useInternalSweepGate and intHighArmed and sweepHigh(lastIntHigh)
internalSSLSweep = showInternalLiquidity and useInternalSweepGate and intLowArmed and sweepLow(lastIntLow)
externalBSLSweep = showExternalLiquidity and extHighArmed and sweepHigh(lastExtHigh)
externalSSLSweep = showExternalLiquidity and extLowArmed and sweepLow(lastExtLow)
pdhSweep = sweepHigh(pdh)
pdlSweep = sweepLow(pdl)
pwhSweep = sweepHigh(pwh)
pwlSweep = sweepLow(pwl)

// Persistent equal-liquidity objects. A level is created from two confirmed
// external pivots, stays extended while untouched, then is relabeled as taken.
var array<float> eqHighLevels = array.new<float>()
var array<line> eqHighLines = array.new<line>()
var array<label> eqHighLabels = array.new<label>()
var array<float> eqLowLevels = array.new<float>()
var array<line> eqLowLines = array.new<line>()
var array<label> eqLowLabels = array.new<label>()

newEqualHigh = useEqualLiquidity and not na(extPH) and not na(lastExtHigh[1]) and math.abs(extPH - lastExtHigh[1]) <= atr * equalToleranceATR
newEqualLow = useEqualLiquidity and not na(extPL) and not na(lastExtLow[1]) and math.abs(extPL - lastExtLow[1]) <= atr * equalToleranceATR

addEqualLevel(bool isHigh, float level, int leftBar) =>
    color levelColor = liqColor
    line ln = line.new(leftBar, level, bar_index, level, xloc = xloc.bar_index, extend = extend.right, color = color.new(levelColor, 10), width = 1, style = line.style_dashed)
    label lb = label.new(bar_index, level, isHigh ? labelEQHUntouched : labelEQLUntouched, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = levelColor, size = size.tiny)
    if isHigh
        array.push(eqHighLevels, level)
        array.push(eqHighLines, ln)
        array.push(eqHighLabels, lb)
        if array.size(eqHighLevels) > maxEqualLevels
            array.shift(eqHighLevels)
            line.delete(array.shift(eqHighLines))
            label.delete(array.shift(eqHighLabels))
    else
        array.push(eqLowLevels, level)
        array.push(eqLowLines, ln)
        array.push(eqLowLabels, lb)
        if array.size(eqLowLevels) > maxEqualLevels
            array.shift(eqLowLevels)
            line.delete(array.shift(eqLowLines))
            label.delete(array.shift(eqLowLabels))

if newEqualHigh
    addEqualLevel(true, (extPH + lastExtHigh[1]) / 2.0, bar_index - externalLen)
if newEqualLow
    addEqualLevel(false, (extPL + lastExtLow[1]) / 2.0, bar_index - externalLen)

var bool eqhSweep = false
var bool eqlSweep = false
var float eqhSweepLevel = na
var float eqlSweepLevel = na
eqhSweep := false
eqlSweep := false
eqhSweepLevel := na
eqlSweepLevel := na

if array.size(eqHighLevels) > 0
    for i = array.size(eqHighLevels) - 1 to 0
        float level = array.get(eqHighLevels, i)
        line ln = array.get(eqHighLines, i)
        label lb = array.get(eqHighLabels, i)
        label.set_x(lb, bar_index)
        if sweepHigh(level)
            eqhSweep := true
            eqhSweepLevel := level
            line.set_extend(ln, extend.none)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(bearColor, 25))
            label.set_text(lb, labelEQHTaken)
            label.set_textcolor(lb, bearColor)
            array.remove(eqHighLevels, i)
            array.remove(eqHighLines, i)
            array.remove(eqHighLabels, i)
        else if not showUntouchedEqualLevels
            line.set_color(ln, color.new(liqColor, 100))
            label.set_textcolor(lb, color.new(liqColor, 100))

if array.size(eqLowLevels) > 0
    for i = array.size(eqLowLevels) - 1 to 0
        float level = array.get(eqLowLevels, i)
        line ln = array.get(eqLowLines, i)
        label lb = array.get(eqLowLabels, i)
        label.set_x(lb, bar_index)
        if sweepLow(level)
            eqlSweep := true
            eqlSweepLevel := level
            line.set_extend(ln, extend.none)
            line.set_x2(ln, bar_index)
            line.set_color(ln, color.new(bullColor, 25))
            label.set_text(lb, labelEQLTaken)
            label.set_textcolor(lb, bullColor)
            array.remove(eqLowLevels, i)
            array.remove(eqLowLines, i)
            array.remove(eqLowLabels, i)
        else if not showUntouchedEqualLevels
            line.set_color(ln, color.new(liqColor, 100))
            label.set_textcolor(lb, color.new(liqColor, 100))

buySideSweep = internalBSLSweep or externalBSLSweep or pdhSweep or pwhSweep or eqhSweep
sellSideSweep = internalSSLSweep or externalSSLSweep or pdlSweep or pwlSweep or eqlSweep

var int lastBSLSweepBar = na
var int lastSSLSweepBar = na
var string lastLiquidityEvent = "None"
var float lastLiquidityLevel = na
var float lastBSLSweepLevel = na
var float lastSSLSweepLevel = na

if buySideSweep
    lastBSLSweepBar := bar_index
    lastLiquidityLevel := pdhSweep ? pdh : pwhSweep ? pwh : eqhSweep ? eqhSweepLevel : internalBSLSweep ? lastIntHigh : lastExtHigh
    lastBSLSweepLevel := lastLiquidityLevel
    lastLiquidityEvent := pdhSweep ? "PDH swept" : pwhSweep ? "PWH swept" : eqhSweep ? "EQH swept" : internalBSLSweep ? "Internal BSL swept" : "External BSL swept"

if sellSideSweep
    lastSSLSweepBar := bar_index
    lastLiquidityLevel := pdlSweep ? pdl : pwlSweep ? pwl : eqlSweep ? eqlSweepLevel : internalSSLSweep ? lastIntLow : lastExtLow
    lastSSLSweepLevel := lastLiquidityLevel
    lastLiquidityEvent := pdlSweep ? "PDL swept" : pwlSweep ? "PWL swept" : eqlSweep ? "EQL swept" : internalSSLSweep ? "Internal SSL swept" : "External SSL swept"

recentBSLSweep = not na(lastBSLSweepBar) and bar_index - lastBSLSweepBar <= sweepToBreakBars
recentSSLSweep = not na(lastSSLSweepBar) and bar_index - lastSSLSweepBar <= sweepToBreakBars

var array<line> liquidityLines = array.new<line>()
var array<label> liquidityLabels = array.new<label>()

addLiquidityMark(string txt, float level, color markColor) =>
    if showSweepMarks and showLiquidityLines and not na(level)
        line ln = line.new(bar_index - liquidityLineBars, level, bar_index, level, xloc = xloc.bar_index, extend = extend.none, color = markColor, width = 1, style = line.style_dashed)
        label lb = label.new(bar_index - math.max(1, int(math.floor(liquidityLineBars / 2))), level, txt, xloc = xloc.bar_index, yloc = yloc.price, style = label.style_none, textcolor = markColor, size = size.tiny)
        array.push(liquidityLines, ln)
        array.push(liquidityLabels, lb)
        if array.size(liquidityLines) > maxLiquidityMarks
            line.delete(array.shift(liquidityLines))
            label.delete(array.shift(liquidityLabels))

// Liquidity labels are drawn later, after OB validation, so BSL / SSL marks
// only appear where an institutional footprint is confirmed.
var int lastBSLMarkBar = na
var int lastSSLMarkBar = na
var float lastBSLMarkLevel = na
var float lastSSLMarkLevel = na

//=============================================================================
// 8. MARKET STRUCTURE ENGINE 2.0 — CLASSIFICATION & STATE
// Direction state is explicit for internal and external structure.
// BOS continues the prior state. CHoCH breaks against the prior state.
//=============================================================================
var int internalTrend = 0
var int externalTrend = 0
var int orderFlow = 0
var string latestStructureEvent = "Waiting"
var float latestStructureLevel = na
var int latestStructureBar = na
var bool latestStructureExternal = false

bullSweepGate = not requireSweepBeforeMSS or recentSSLSweep
bearSweepGate = not requireSweepBeforeMSS or recentBSLSweep
bullBOSGate = not requireSweepBeforeBOS or recentSSLSweep
bearBOSGate = not requireSweepBeforeBOS or recentBSLSweep

bullStructureDisplacementGate = not requireDisplacementForStructure or bullDisplacement
bearStructureDisplacementGate = not requireDisplacementForStructure or bearDisplacement

qualifiedInternalBullBreak = internalBullBreakRaw and bullStructureDisplacementGate
qualifiedInternalBearBreak = internalBearBreakRaw and bearStructureDisplacementGate
qualifiedExternalBullBreak = externalBullBreakRaw and bullStructureDisplacementGate
qualifiedExternalBearBreak = externalBearBreakRaw and bearStructureDisplacementGate

internalBullCHoCH = qualifiedInternalBullBreak and internalTrend == -1 and bullSweepGate
internalBearCHoCH = qualifiedInternalBearBreak and internalTrend == 1 and bearSweepGate
internalBullBOS = qualifiedInternalBullBreak and internalTrend != -1 and bullBOSGate
internalBearBOS = qualifiedInternalBearBreak and internalTrend != 1 and bearBOSGate

externalBullCHoCH = qualifiedExternalBullBreak and externalTrend == -1 and bullSweepGate
externalBearCHoCH = qualifiedExternalBearBreak and externalTrend == 1 and bearSweepGate
externalBullBOS = qualifiedExternalBullBreak and externalTrend != -1 and bullBOSGate
externalBearBOS = qualifiedExternalBearBreak and externalTrend != 1 and bearBOSGate

// Compatibility aliases used by downstream engines and existing alerts.
bullMSS = internalBullCHoCH or externalBullCHoCH
bearMSS = internalBearCHoCH or externalBearCHoCH
bullInternalBOS = internalBullBOS
bearInternalBOS = internalBearBOS
bullExternalBOS = externalBullBOS
bearExternalBOS = externalBearBOS

// Consume every raw break once, even when a filter rejects classification.
// A new confirmed pivot must appear before the same level can trigger again.
if internalBullBreakRaw
    intHighArmed := false
if internalBearBreakRaw
    intLowArmed := false
if externalBullBreakRaw
    extHighArmed := false
if externalBearBreakRaw
    extLowArmed := false

if internalBullCHoCH or internalBullBOS
    internalTrend := 1
if internalBearCHoCH or internalBearBOS
    internalTrend := -1
if externalBullCHoCH or externalBullBOS
    externalTrend := 1
if externalBearCHoCH or externalBearBOS
    externalTrend := -1

// External structure leads the published order-flow state when available.
if externalBullCHoCH or externalBullBOS
    orderFlow := 1
else if externalBearCHoCH or externalBearBOS
    orderFlow := -1
else if internalBullCHoCH or internalBullBOS
    orderFlow := 1
else if internalBearCHoCH or internalBearBOS
    orderFlow := -1

// Publish one deterministic dashboard event per bar. External events take priority.
if externalBullCHoCH
    latestStructureEvent := "Bullish CHoCH"
    latestStructureLevel := lastExtHigh
    latestStructureBar := bar_index
    latestStructureExternal := true
else if externalBearCHoCH
    latestStructureEvent := "Bearish CHoCH"
    latestStructureLevel := lastExtLow
    latestStructureBar := bar_index
    latestStructureExternal := true
else if externalBullBOS
    latestStructureEvent := "Bullish BOS"
    latestStructureLevel := lastExtHigh
    latestStructureBar := bar_index
    latestStructureExternal := true
else if externalBearBOS
    latestStructureEvent := "Bearish BOS"
    latestStructureLevel := lastExtLow
    latestStructureBar := bar_index
    latestStructureExternal := true
else if internalBullCHoCH
    latestStructureEvent := "Bullish CHoCH"
    latestStructureLevel := lastIntHigh
    latestStructureBar := bar_index
    latestStructureExternal := false
else if internalBearCHoCH
    latestStructureEvent := "Bearish CHoCH"
    latestStructureLevel := lastIntLow
    latestStructureBar := bar_index
    latestStructureExternal := false
else if internalBullBOS
    latestStructureEvent := "Bullish BOS"
    latestStructureLevel := lastIntHigh
    latestStructureBar := bar_index
    latestStructureExternal := false
else if internalBearBOS
    latestStructureEvent := "Bearish BOS"
    latestStructureLevel := lastIntLow
    latestStructureBar := bar_index
    latestStructureExternal := false

// Stable outputs for downstream modules.
bullStructureEvent = internalBullCHoCH or internalBullBOS or externalBullCHoCH or externalBullBOS
bearStructureEvent = internalBearCHoCH or internalBearBOS or externalBearCHoCH or externalBearBOS
externalStructureEvent = externalBullCHoCH or externalBearCHoCH or externalBullBOS or externalBearBOS

//=============================================================================
// 8A. SNIPER MODEL ENGINE PR1 / PR2 — PROTECTED LEVEL TRACKER
// Tracks the protected high for bearish sniper setups and the protected low for
// bullish sniper setups. Internal liquidity sweeps can remain valid, but a sweep
// of the protected level invalidates / resets the sniper setup.
// PR2 keeps this guard intact and adds internal sweep validation later in the execution flow.
// PR3 adds HTF liquidity-zone context without changing protected-level behavior.
//=============================================================================
protectedHighBroken(float level) =>
    not na(level) and (protectedLevelBreakMode == "Close Break" ? close > level : high > level)

protectedLowBroken(float level) =>
    not na(level) and (protectedLevelBreakMode == "Close Break" ? close < level : low < level)

float newBearProtectedHigh = not na(lastExtHigh) ? lastExtHigh : lastIntHigh
int newBearProtectedHighBar = not na(lastExtHigh) ? lastExtHighBar : lastIntHighBar
float newBullProtectedLow = not na(lastExtLow) ? lastExtLow : lastIntLow
int newBullProtectedLowBar = not na(lastExtLow) ? lastExtLowBar : lastIntLowBar

var float sniperProtectedHigh = na
var float sniperProtectedLow = na
var int sniperProtectedHighBar = na
var int sniperProtectedLowBar = na
var int sniperProtectedHighSetBar = na
var int sniperProtectedLowSetBar = na
var bool sniperBearProtectedHighActive = false
var bool sniperBullProtectedLowActive = false
var bool sniperBearSetupInvalidated = false
var bool sniperBullSetupInvalidated = false
var string lastSniperInvalidationText = "None"

if enableSniperModel and bearStructureEvent and not na(newBearProtectedHigh)
    sniperProtectedHigh := newBearProtectedHigh
    sniperProtectedHighBar := newBearProtectedHighBar
    sniperProtectedHighSetBar := bar_index
    sniperBearProtectedHighActive := true
    sniperBearSetupInvalidated := false
    lastSniperInvalidationText := "Bear protected high armed"

if enableSniperModel and bullStructureEvent and not na(newBullProtectedLow)
    sniperProtectedLow := newBullProtectedLow
    sniperProtectedLowBar := newBullProtectedLowBar
    sniperProtectedLowSetBar := bar_index
    sniperBullProtectedLowActive := true
    sniperBullSetupInvalidated := false
    lastSniperInvalidationText := "Bull protected low armed"

sniperBearProtectedHighSweptNow = enableSniperModel and sniperBearProtectedHighActive and not na(sniperProtectedHigh) and
     not na(sniperProtectedHighSetBar) and bar_index > sniperProtectedHighSetBar and protectedHighBroken(sniperProtectedHigh)

sniperBullProtectedLowSweptNow = enableSniperModel and sniperBullProtectedLowActive and not na(sniperProtectedLow) and
     not na(sniperProtectedLowSetBar) and bar_index > sniperProtectedLowSetBar and protectedLowBroken(sniperProtectedLow)

if sniperBearProtectedHighSweptNow
    sniperBearProtectedHighActive := false
    sniperBearSetupInvalidated := true
    lastSniperInvalidationText := "Bear protected high swept"

if sniperBullProtectedLowSweptNow
    sniperBullProtectedLowActive := false
    sniperBullSetupInvalidated := true
    lastSniperInvalidationText := "Bull protected low swept"

sniperProtectedHighText = not na(sniperProtectedHigh) ? str.tostring(sniperProtectedHigh, format.mintick) : "—"
sniperProtectedLowText = not na(sniperProtectedLow) ? str.tostring(sniperProtectedLow, format.mintick) : "—"

sniperBearGuardText = sniperBearSetupInvalidated ? "Bear PH swept / reset" :
     sniperBearProtectedHighActive ? "Bear PH intact @ " + sniperProtectedHighText : "Bear PH waiting"

sniperBullGuardText = sniperBullSetupInvalidated ? "Bull PL swept / reset" :
     sniperBullProtectedLowActive ? "Bull PL intact @ " + sniperProtectedLowText : "Bull PL waiting"

sniperProtectedGuardText = orderFlow == -1 ? sniperBearGuardText :
     orderFlow == 1 ? sniperBullGuardText :
     sniperBearProtectedHighActive ? sniperBearGuardText :
     sniperBullProtectedLowActive ? sniperBullGuardText : "Protected level waiting"

sniperProtectedGuardColor = str.contains(sniperProtectedGuardText, "swept") ? bearColor :
     str.contains(sniperProtectedGuardText, "intact") ? bullColor : neutralColor

plot(showSniperProtectedLevels and enableSniperModel ? sniperProtectedHigh : na, "Sniper Protected High", color = color.new(bearColor, 20), style = plot.style_linebr)
plot(showSniperProtectedLevels and enableSniperModel ? sniperProtectedLow : na, "Sniper Protected Low", color = color.new(bullColor, 20), style = plot.style_linebr)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? sniperProtectedHigh : na, "Sniper Protected High Value", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? sniperProtectedLow : na, "Sniper Protected Low Value", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? (sniperBearProtectedHighSweptNow ? 1 : 0) : na, "Sniper Bear Protected High Swept", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? (sniperBullProtectedLowSweptNow ? 1 : 0) : na, "Sniper Bull Protected Low Swept", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? (sniperBearProtectedHighActive ? 1 : 0) : na, "Sniper Bear Protected High Active", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showSniperDebug ? (sniperBullProtectedLowActive ? 1 : 0) : na, "Sniper Bull Protected Low Active", display = display.data_window)

//=============================================================================
// 9. ORDER BLOCK / FVG CANDIDATES
//=============================================================================
int bullOBOffset = na
float bullOBTopCandidate = na
float bullOBBottomCandidate = na

bullSweepAge = recentSSLSweep ? bar_index - lastSSLSweepBar : obSearchBars
bullOBSearchLimit = math.max(1, math.min(obSearchBars, bullSweepAge))

for i = 1 to bullOBSearchLimit
    if na(bullOBOffset) and close[i] < open[i]
        bullOBOffset := i
        bullOBTopCandidate := useBodyForOB ? open[i] : high[i]
        bullOBBottomCandidate := useBodyForOB ? close[i] : low[i]

int bearOBOffset = na
float bearOBTopCandidate = na
float bearOBBottomCandidate = na

bearSweepAge = recentBSLSweep ? bar_index - lastBSLSweepBar : obSearchBars
bearOBSearchLimit = math.max(1, math.min(obSearchBars, bearSweepAge))

for i = 1 to bearOBSearchLimit
    if na(bearOBOffset) and close[i] > open[i]
        bearOBOffset := i
        bearOBTopCandidate := useBodyForOB ? close[i] : high[i]
        bearOBBottomCandidate := useBodyForOB ? open[i] : low[i]

bullFVGTopCandidate = bullFVGNow ? low : na
bullFVGBottomCandidate = bullFVGNow ? high[2] : na
bearFVGTopCandidate = bearFVGNow ? low[2] : na
bearFVGBottomCandidate = bearFVGNow ? high : na

//=============================================================================
// 10. SCORE + QUALIFICATION
// Bias 25, liquidity 20, displacement 15, MSS/BOS 20, OB 10, FVG 5, time 5.
//=============================================================================

bullOBOK = not na(bullOBOffset)
bearOBOK = not na(bearOBOffset)
bullFVGOK = bullFVGNow
bearFVGOK = bearFVGNow

// Institutional OB validation:
// 1) the displacement candle must close beyond the selected opposite candle,
// 2) the OB may be required to overlap the setup FVG.
bullOBDisplaced = bullOBOK and close > bullOBTopCandidate
bearOBDisplaced = bearOBOK and close < bearOBBottomCandidate

bullOBFVGOverlap = bullOBOK and bullFVGOK and
     math.max(bullOBBottomCandidate, bullFVGBottomCandidate) <= math.min(bullOBTopCandidate, bullFVGTopCandidate)
bearOBFVGOverlap = bearOBOK and bearFVGOK and
     math.max(bearOBBottomCandidate, bearFVGBottomCandidate) <= math.min(bearOBTopCandidate, bearFVGTopCandidate)

bullInstitutionalOB = bullOBDisplaced and (not requireOBFVGOverlap or bullOBFVGOverlap)
bearInstitutionalOB = bearOBDisplaced and (not requireOBFVGOverlap or bearOBFVGOverlap)

bullFVGRequirement = not requireFVGForSetup or bullFVGOK
bearFVGRequirement = not requireFVGForSetup or bearFVGOK

bullScore = (bullBias ? 25 : 0) +
     (recentSSLSweep ? 20 : 0) +
     (bullDisplacement ? 15 : 0) +
     (bullStructureEvent ? 20 : 0) +
     (bullInstitutionalOB ? 10 : 0) +
     (bullFVGOK ? 5 : 0) +
     (sessionAllowed ? 5 : 0)

bearScore = (bearBias ? 25 : 0) +
     (recentBSLSweep ? 20 : 0) +
     (bearDisplacement ? 15 : 0) +
     (bearStructureEvent ? 20 : 0) +
     (bearInstitutionalOB ? 10 : 0) +
     (bearFVGOK ? 5 : 0) +
     (sessionAllowed ? 5 : 0)

bullQualified = bullStructureEvent and bullBias and recentSSLSweep and bullDisplacement and bullInstitutionalOB and bullFVGRequirement and sessionAllowed and bullScore >= minimumScore
bearQualified = bearStructureEvent and bearBias and recentBSLSweep and bearDisplacement and bearInstitutionalOB and bearFVGRequirement and sessionAllowed and bearScore >= minimumScore

//=============================================================================
// 11. INSTITUTIONAL MARKET-STRUCTURE LINES
// Tiny text with dashed lines anchored to the broken swing level and extended past the break.
//=============================================================================
var array<line> structureLines = array.new<line>()
var array<label> structureLabels = array.new<label>()

addStructureMark(string txt, int swingBar, float level, color markColor, bool externalEvent) =>
    if showStructureLines and not na(level)
        int configuredLength = externalEvent ? externalStructureLineBars : internalStructureLineBars
        int fallbackLeft = bar_index - configuredLength
        int requestedLeft = anchorStructureAtSwing and not na(swingBar) ? swingBar : fallbackLeft
        int leftBar = math.max(fallbackLeft, requestedLeft)
        int rightBar = bar_index + structureForwardBars
        int centerBar = leftBar + int(math.floor((rightBar - leftBar) / 2.0))
        int nearBreakBar = math.max(leftBar, bar_index - 1)
        int textBar = structureLabelPosition == "Centered" ? centerBar : nearBreakBar
        int internalFade = fadeInternalStructure ? 35 : 10
        color eventColor = externalEvent ? color.new(markColor, 0) : color.new(markColor, internalFade)
        line ln = line.new(
             leftBar, level, rightBar, level,
             xloc = xloc.bar_index, extend = extend.none,
             color = eventColor, width = structureLineWidth, style = line.style_dashed
         )
        label lb = label.new(
             textBar, level, txt,
             xloc = xloc.bar_index, yloc = yloc.price,
             style = label.style_none, textcolor = eventColor, size = size.tiny
         )
        array.push(structureLines, ln)
        array.push(structureLabels, lb)
        if array.size(structureLines) > maxLabels
            line.delete(array.shift(structureLines))
            label.delete(array.shift(structureLabels))

if showInternalEvents and internalBullCHoCH
    addStructureMark(labelBullCHoCH, lastIntHighBar, lastIntHigh, chochBullColor, false)
if showInternalEvents and internalBearCHoCH
    addStructureMark(labelBearCHoCH, lastIntLowBar, lastIntLow, chochBearColor, false)
if showInternalEvents and internalBullBOS
    addStructureMark(labelBullBOS, lastIntHighBar, lastIntHigh, bullColor, false)
if showInternalEvents and internalBearBOS
    addStructureMark(labelBearBOS, lastIntLowBar, lastIntLow, bearColor, false)
if showExternalEvents and externalBullCHoCH
    addStructureMark(labelBullCHoCH, lastExtHighBar, lastExtHigh, chochBullColor, true)
if showExternalEvents and externalBearCHoCH
    addStructureMark(labelBearCHoCH, lastExtLowBar, lastExtLow, chochBearColor, true)
if showExternalEvents and externalBullBOS
    addStructureMark(labelBullBOS, lastExtHighBar, lastExtHigh, bullColor, true)
if showExternalEvents and externalBearBOS
    addStructureMark(labelBearBOS, lastExtLowBar, lastExtLow, bearColor, true)


//=============================================================================
// 11A. ZIG ZAG MARKET STRUCTURE OVERLAY — PR1 / PR2 / PR3
// Uses confirmed swing highs / lows only. This keeps the overlay clean, avoids
// repainting the current candle, and does not add TradingView plot usage.
// PR3 classifies the latest HH / HL / LH / LL sequence as bullish, bearish, transition, or mixed structure.
//=============================================================================
zigZagSourceIsInternal = zigZagSwingSource == "Internal"
zigZagHighPivot = zigZagSourceIsInternal ? intPH : extPH
zigZagLowPivot = zigZagSourceIsInternal ? intPL : extPL
zigZagHighPivotBar = zigZagSourceIsInternal ? bar_index - internalLen : bar_index - externalLen
zigZagLowPivotBar = zigZagSourceIsInternal ? bar_index - internalLen : bar_index - externalLen

zigZagRawLabel(string rawText) =>
    zigZagLabelMode == "Full" ?
         rawText == "HH" ? "Higher High" :
         rawText == "HL" ? "Higher Low" :
         rawText == "LH" ? "Lower High" :
         rawText == "LL" ? "Lower Low" :
         rawText == "H" ? "High" :
         rawText == "L" ? "Low" : rawText :
     rawText

zigZagPriceLabel(string rawText, float pivotPrice, bool isHigh) =>
    string structureText = zigZagRawLabel(rawText)
    string priceText = str.tostring(pivotPrice, format.mintick)
    isHigh ? priceText + "\n" + structureText : structureText + "\n" + priceText

zigZagHighLabelY(float pivotPrice) =>
    pivotPrice + atr * zigZagPriceLabelOffsetATR

zigZagLowLabelY(float pivotPrice) =>
    pivotPrice - atr * zigZagPriceLabelOffsetATR

var array<line> zigZagLines = array.new<line>()
var array<label> zigZagLabels = array.new<label>()

var float zigZagLastPivotPrice = na
var int zigZagLastPivotBar = na
var int zigZagLastPivotType = 0
var float zigZagLastHighPrice = na
var float zigZagLastLowPrice = na
var float zigZagCurrentCompareHigh = na
var float zigZagCurrentCompareLow = na
var line zigZagLastLine = na
var label zigZagLastLabel = na
var string zigZagLastMarkText = "—"
var string zigZagLastHighMarkText = "—"
var string zigZagLastLowMarkText = "—"
var string zigZagStructureText = "Waiting"
var string zigZagTrendText = "Waiting"
var color zigZagStructureColor = neutralColor
var color zigZagTrendColor = neutralColor

zigZagHighEvent = showZigZag and not na(zigZagHighPivot)
zigZagLowEvent = showZigZag and not na(zigZagLowPivot)

if zigZagHighEvent
    bool continuingHighSwing = zigZagLastPivotType == 1
    float highComparePrice = continuingHighSwing ? zigZagCurrentCompareHigh : zigZagLastHighPrice
    string highMarkText = na(highComparePrice) ? "H" : zigZagHighPivot > highComparePrice ? "HH" : "LH"
    color highMarkColor = highMarkText == "HH" ? bullColor : highMarkText == "LH" ? bearColor : neutralColor

    if zigZagLastPivotType == 1
        bool replaceHigh = na(zigZagLastPivotPrice) or zigZagHighPivot >= zigZagLastPivotPrice
        if replaceHigh
            zigZagLastPivotPrice := zigZagHighPivot
            zigZagLastPivotBar := zigZagHighPivotBar
            zigZagLastHighPrice := zigZagHighPivot
            zigZagLastMarkText := highMarkText
            zigZagLastHighMarkText := highMarkText
            zigZagStructureText := zigZagSwingSource + " " + highMarkText
            zigZagStructureColor := highMarkColor

            if not na(zigZagLastLine)
                line.set_x2(zigZagLastLine, zigZagHighPivotBar)
                line.set_y2(zigZagLastLine, zigZagHighPivot)

            if showZigZagLabels and zigZagLabelMode != "Off" and not na(zigZagLastLabel)
                label.set_x(zigZagLastLabel, zigZagHighPivotBar)
                label.set_y(zigZagLastLabel, zigZagHighLabelY(zigZagHighPivot))
                label.set_text(zigZagLastLabel, zigZagPriceLabel(highMarkText, zigZagHighPivot, true))
                label.set_textcolor(zigZagLastLabel, highMarkColor)
                label.set_style(zigZagLastLabel, label.style_label_down)
                label.set_color(zigZagLastLabel, color.new(color.black, 20))
                label.set_size(zigZagLastLabel, size.small)
    else
        line newZigLine = na
        label newZigLabel = na

        if not na(zigZagLastPivotPrice) and not na(zigZagLastPivotBar)
            newZigLine := line.new(
                 zigZagLastPivotBar, zigZagLastPivotPrice,
                 zigZagHighPivotBar, zigZagHighPivot,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = color.new(highMarkColor, 15),
                 width = zigZagLineWidth
             )
            array.push(zigZagLines, newZigLine)

        if showZigZagLabels and zigZagLabelMode != "Off"
            newZigLabel := label.new(
                 zigZagHighPivotBar, zigZagHighLabelY(zigZagHighPivot),
                 zigZagPriceLabel(highMarkText, zigZagHighPivot, true),
                 xloc = xloc.bar_index,
                 yloc = yloc.price,
                 style = label.style_label_down,
                 color = color.new(color.black, 20),
                 textcolor = highMarkColor,
                 size = size.small
             )
            array.push(zigZagLabels, newZigLabel)

        while array.size(zigZagLines) > maxZigZagLegs
            line oldZigLine = array.shift(zigZagLines)
            if not na(oldZigLine)
                line.delete(oldZigLine)

        while array.size(zigZagLabels) > maxZigZagLegs + 1
            label oldZigLabel = array.shift(zigZagLabels)
            if not na(oldZigLabel)
                label.delete(oldZigLabel)

        zigZagCurrentCompareHigh := zigZagLastHighPrice
        zigZagLastHighPrice := zigZagHighPivot
        zigZagLastPivotPrice := zigZagHighPivot
        zigZagLastPivotBar := zigZagHighPivotBar
        zigZagLastPivotType := 1
        zigZagLastLine := newZigLine
        zigZagLastLabel := newZigLabel
        zigZagLastMarkText := highMarkText
        zigZagLastHighMarkText := highMarkText
        zigZagStructureText := zigZagSwingSource + " " + highMarkText
        zigZagStructureColor := highMarkColor

if zigZagLowEvent
    bool continuingLowSwing = zigZagLastPivotType == -1
    float lowComparePrice = continuingLowSwing ? zigZagCurrentCompareLow : zigZagLastLowPrice
    string lowMarkText = na(lowComparePrice) ? "L" : zigZagLowPivot > lowComparePrice ? "HL" : "LL"
    color lowMarkColor = lowMarkText == "HL" ? bullColor : lowMarkText == "LL" ? bearColor : neutralColor

    if zigZagLastPivotType == -1
        bool replaceLow = na(zigZagLastPivotPrice) or zigZagLowPivot <= zigZagLastPivotPrice
        if replaceLow
            zigZagLastPivotPrice := zigZagLowPivot
            zigZagLastPivotBar := zigZagLowPivotBar
            zigZagLastLowPrice := zigZagLowPivot
            zigZagLastMarkText := lowMarkText
            zigZagLastLowMarkText := lowMarkText
            zigZagStructureText := zigZagSwingSource + " " + lowMarkText
            zigZagStructureColor := lowMarkColor

            if not na(zigZagLastLine)
                line.set_x2(zigZagLastLine, zigZagLowPivotBar)
                line.set_y2(zigZagLastLine, zigZagLowPivot)

            if showZigZagLabels and zigZagLabelMode != "Off" and not na(zigZagLastLabel)
                label.set_x(zigZagLastLabel, zigZagLowPivotBar)
                label.set_y(zigZagLastLabel, zigZagLowLabelY(zigZagLowPivot))
                label.set_text(zigZagLastLabel, zigZagPriceLabel(lowMarkText, zigZagLowPivot, false))
                label.set_textcolor(zigZagLastLabel, lowMarkColor)
                label.set_style(zigZagLastLabel, label.style_label_up)
                label.set_color(zigZagLastLabel, color.new(color.black, 20))
                label.set_size(zigZagLastLabel, size.small)
    else
        line newZigLine = na
        label newZigLabel = na

        if not na(zigZagLastPivotPrice) and not na(zigZagLastPivotBar)
            newZigLine := line.new(
                 zigZagLastPivotBar, zigZagLastPivotPrice,
                 zigZagLowPivotBar, zigZagLowPivot,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = color.new(lowMarkColor, 15),
                 width = zigZagLineWidth
             )
            array.push(zigZagLines, newZigLine)

        if showZigZagLabels and zigZagLabelMode != "Off"
            newZigLabel := label.new(
                 zigZagLowPivotBar, zigZagLowLabelY(zigZagLowPivot),
                 zigZagPriceLabel(lowMarkText, zigZagLowPivot, false),
                 xloc = xloc.bar_index,
                 yloc = yloc.price,
                 style = label.style_label_up,
                 color = color.new(color.black, 20),
                 textcolor = lowMarkColor,
                 size = size.small
             )
            array.push(zigZagLabels, newZigLabel)

        while array.size(zigZagLines) > maxZigZagLegs
            line oldZigLine = array.shift(zigZagLines)
            if not na(oldZigLine)
                line.delete(oldZigLine)

        while array.size(zigZagLabels) > maxZigZagLegs + 1
            label oldZigLabel = array.shift(zigZagLabels)
            if not na(oldZigLabel)
                label.delete(oldZigLabel)

        zigZagCurrentCompareLow := zigZagLastLowPrice
        zigZagLastLowPrice := zigZagLowPivot
        zigZagLastPivotPrice := zigZagLowPivot
        zigZagLastPivotBar := zigZagLowPivotBar
        zigZagLastPivotType := -1
        zigZagLastLine := newZigLine
        zigZagLastLabel := newZigLabel
        zigZagLastMarkText := lowMarkText
        zigZagLastLowMarkText := lowMarkText
        zigZagStructureText := zigZagSwingSource + " " + lowMarkText
        zigZagStructureColor := lowMarkColor

zigZagHasAnyHigh = zigZagLastHighMarkText != "—"
zigZagHasAnyLow = zigZagLastLowMarkText != "—"
zigZagHasClassifiedHigh = zigZagLastHighMarkText == "HH" or zigZagLastHighMarkText == "LH"
zigZagHasClassifiedLow = zigZagLastLowMarkText == "HL" or zigZagLastLowMarkText == "LL"
zigZagBullStructure = zigZagLastHighMarkText == "HH" and zigZagLastLowMarkText == "HL"
zigZagBearStructure = zigZagLastHighMarkText == "LH" and zigZagLastLowMarkText == "LL"
zigZagTransitionStructure = zigZagHasClassifiedHigh and zigZagHasClassifiedLow and not zigZagBullStructure and not zigZagBearStructure

zigZagTrendText := not showZigZag ? "Off" :
     (not zigZagHasAnyHigh or not zigZagHasAnyLow) ? "Waiting" :
     (not zigZagHasClassifiedHigh or not zigZagHasClassifiedLow) ? "Range / Mixed" :
     zigZagBullStructure ? "Bullish Structure" :
     zigZagBearStructure ? "Bearish Structure" :
     zigZagTransitionStructure ? "Transition" : "Range / Mixed"

zigZagTrendColor := not showZigZag ? neutralColor :
     zigZagBullStructure ? bullColor :
     zigZagBearStructure ? bearColor :
     zigZagTransitionStructure ? liqColor : neutralColor

zigZagDashboardText = not showZigZag ? "Off" :
     zigZagTrendText == "Waiting" ? "Waiting for swings" :
     zigZagTrendText + " / " + zigZagSwingSource + " " + zigZagLastMarkText

zigZagDashboardColor = not showZigZag ? neutralColor : zigZagTrendColor

//=============================================================================
// 12. HIGHLIGHTED ORDER-BLOCK / FVG ZONES
// Validated OBs are drawn even when the full setup is rejected by HTF bias,
// session, or minimum-score filters. This separates zone identification from
// trade qualification and makes the institutional candle easy to recognize.
//=============================================================================
var array<box> obBoxes = array.new<box>()
var box activeOB = na
var box activeFVG = na
var bool activeBullish = false
var float activeOBTop = na
var float activeOBBottom = na
var float activeFVGTop = na
var float activeFVGBottom = na
var bool obActive = false
var bool fvgActive = false
var int activeZoneCreatedBar = na

addOBZone(bool bullish, int leftBar, float zoneTop, float zoneBottom) =>
    string priceText = str.tostring(zoneTop, format.mintick) + " - " + str.tostring(zoneBottom, format.mintick)
    string fullDirectionText = bullish ? "Bullish Order Block" : "Bearish Order Block"
    string shortDirectionText = bullish ? "Bullish OB" : "Bearish OB"
    string zoneTextLabel = obLabelModeFull and showOBPriceText ? "NEWEST  •  " + fullDirectionText + "\n" + priceText : obLabelModeShort ? shortDirectionText : ""
    color zoneColor = bullish ? bullColor : bearColor
    box newZone = box.new(
         leftBar, zoneTop, bar_index, zoneBottom,
         xloc = xloc.bar_index,
         extend = extend.right,
         border_color = color.new(zoneColor, 0),
         border_width = obBorderWidth,
         bgcolor = color.new(zoneColor, obZoneOpacity),
         text = zoneTextLabel,
         text_color = color.white,
         text_size = obLabelModeFull ? size.tiny : size.tiny,
         text_halign = text.align_center,
         text_valign = text.align_center
     )
    array.push(obBoxes, newZone)
    if array.size(obBoxes) > maxOBZones
        box.delete(array.shift(obBoxes))
    newZone

obMitigatedText(bool bullish) =>
    obLabelModeFull ? (bullish ? "Bullish OB  MITIGATED" : "Bearish OB  MITIGATED") : obLabelModeShort ? "OB MIT" : ""

fvgZoneText(bool bullish, float zoneTop, float zoneBottom) =>
    string priceText = str.tostring(zoneTop, format.mintick) + " - " + str.tostring(zoneBottom, format.mintick)
    string directionText = bullish ? "Bullish FVG" : "Bearish FVG"
    fvgLabelModeFull ? directionText + "\n" + priceText : fvgLabelModeShort ? "FVG" : ""

// Draw the zone as soon as structure + displacement validate the OB.
// Full qualification remains responsible for arrows and trade plans.
bullOBZoneSignal = bullStructureEvent and bullInstitutionalOB and bullFVGRequirement
bearOBZoneSignal = bearStructureEvent and bearInstitutionalOB and bearFVGRequirement

if bullOBZoneSignal
    activeBullish := true
    activeOBTop := bullOBTopCandidate
    activeOBBottom := bullOBBottomCandidate
    activeFVGTop := bullFVGTopCandidate
    activeFVGBottom := bullFVGBottomCandidate
    obActive := true
    fvgActive := bullFVGOK
    activeZoneCreatedBar := bar_index

    if showOrderBlock
        activeOB := addOBZone(true, bar_index - bullOBOffset, activeOBTop, activeOBBottom)

    if showFVG and bullFVGOK
        box.delete(activeFVG)
        activeFVG := box.new(
             bar_index - 2, activeFVGTop, bar_index, activeFVGBottom,
             xloc = xloc.bar_index, extend = extend.right,
             border_color = color.new(bullColor, 5), border_width = 1, border_style = line.style_dashed,
             bgcolor = color.new(bullColor, 90),
             text = fvgZoneText(true, activeFVGTop, activeFVGBottom),
             text_color = color.white, text_size = size.tiny,
             text_halign = text.align_center, text_valign = text.align_center
         )

if bearOBZoneSignal
    activeBullish := false
    activeOBTop := bearOBTopCandidate
    activeOBBottom := bearOBBottomCandidate
    activeFVGTop := bearFVGTopCandidate
    activeFVGBottom := bearFVGBottomCandidate
    obActive := true
    fvgActive := bearFVGOK
    activeZoneCreatedBar := bar_index

    if showOrderBlock
        activeOB := addOBZone(false, bar_index - bearOBOffset, activeOBTop, activeOBBottom)

    if showFVG and bearFVGOK
        box.delete(activeFVG)
        activeFVG := box.new(
             bar_index - 2, activeFVGTop, bar_index, activeFVGBottom,
             xloc = xloc.bar_index, extend = extend.right,
             border_color = color.new(bearColor, 5), border_width = 1, border_style = line.style_dashed,
             bgcolor = color.new(bearColor, 90),
             text = fvgZoneText(false, activeFVGTop, activeFVGBottom),
             text_color = color.white, text_size = size.tiny,
             text_halign = text.align_center, text_valign = text.align_center
         )

zoneCanMitigate = not na(activeZoneCreatedBar) and bar_index > activeZoneCreatedBar
activeOBMid = (activeOBTop + activeOBBottom) / 2.0

bullOBMitigationPrice = obMitigationMode == "Full" ? activeOBBottom :
     obMitigationMode == "Midpoint" ? activeOBMid : activeOBTop
bearOBMitigationPrice = obMitigationMode == "Full" ? activeOBTop :
     obMitigationMode == "Midpoint" ? activeOBMid : activeOBBottom

obMitigated = obActive and zoneCanMitigate and (
     activeBullish ? low <= bullOBMitigationPrice : high >= bearOBMitigationPrice
)

fvgFilled = fvgActive and zoneCanMitigate and (
     activeBullish ? low <= activeFVGBottom : high >= activeFVGTop
)

if obMitigated
    obActive := false
    if not na(activeOB)
        if deleteMitigated
            box.delete(activeOB)
            activeOB := na
        else
            box.set_extend(activeOB, extend.none)
            box.set_right(activeOB, bar_index)
            box.set_bgcolor(activeOB, color.new(activeBullish ? bullColor : bearColor, 92))
            box.set_text(activeOB, obMitigatedText(activeBullish))

if fvgFilled
    fvgActive := false
    if deleteMitigated
        box.delete(activeFVG)
        activeFVG := na
    else if not na(activeFVG)
        box.set_extend(activeFVG, extend.none)
        box.set_right(activeFVG, bar_index)
        box.set_bgcolor(activeFVG, color.new(fvgColor, 93))

//=============================================================================
// 12A. INSTITUTIONAL LIQUIDITY LABEL FILTER — PR4
// Only prints BSL / SSL labels when a matching validated OB footprint appears.
// Raw liquidity sweeps are still tracked internally for scoring and decisions.
//=============================================================================
liquidityLevelNearActiveOB(float level) =>
    not na(level) and not na(activeOBTop) and not na(activeOBBottom) and
     level <= activeOBTop + atr * liquidityLabelOBProximityATR and
     level >= activeOBBottom - atr * liquidityLabelOBProximityATR

sslHasOBContext = bullOBZoneSignal and recentSSLSweep and (not liquidityLabelsRequireOBContext or liquidityLevelNearActiveOB(lastSSLSweepLevel))
bslHasOBContext = bearOBZoneSignal and recentBSLSweep and (not liquidityLabelsRequireOBContext or liquidityLevelNearActiveOB(lastBSLSweepLevel))

sslInstitutionalMarkOldEnough = na(lastSSLMarkBar) or bar_index - lastSSLMarkBar > liquidityLabelCooldownBars
sslInstitutionalMarkFarEnough = na(lastSSLMarkLevel) or math.abs(lastSSLSweepLevel - lastSSLMarkLevel) > atr * liquidityLabelPriceSpacingATR
sslInstitutionalMarkAllowed = sslInstitutionalMarkOldEnough or sslInstitutionalMarkFarEnough

bslInstitutionalMarkOldEnough = na(lastBSLMarkBar) or bar_index - lastBSLMarkBar > liquidityLabelCooldownBars
bslInstitutionalMarkFarEnough = na(lastBSLMarkLevel) or math.abs(lastBSLSweepLevel - lastBSLMarkLevel) > atr * liquidityLabelPriceSpacingATR
bslInstitutionalMarkAllowed = bslInstitutionalMarkOldEnough or bslInstitutionalMarkFarEnough

if sslHasOBContext and sslInstitutionalMarkAllowed
    addLiquidityMark(labelSSLTaken, lastSSLSweepLevel, bullColor)
    lastSSLMarkBar := bar_index
    lastSSLMarkLevel := lastSSLSweepLevel

if bslHasOBContext and bslInstitutionalMarkAllowed
    addLiquidityMark(labelBSLTaken, lastBSLSweepLevel, bearColor)
    lastBSLMarkBar := bar_index
    lastBSLMarkLevel := lastBSLSweepLevel

plotshape(showSweepMarks and not showLiquidityLines and sslHasOBContext and sslInstitutionalMarkAllowed, "Sell-side institutional liquidity mark", shape.xcross, location.belowbar, liqColor, size = size.tiny, text = "SSL")
plotshape(showSweepMarks and not showLiquidityLines and bslHasOBContext and bslInstitutionalMarkAllowed, "Buy-side institutional liquidity mark", shape.xcross, location.abovebar, liqColor, size = size.tiny, text = "BSL")

//=============================================================================
// 13. DECISION ENGINE 2.0 — PR3
// One source of truth for dashboard, trade plan, setup markers, and alerts.
//=============================================================================
extRangeValidDecision = not na(lastExtHigh) and not na(lastExtLow) and lastExtHigh > lastExtLow
decisionRange = extRangeValidDecision ? lastExtHigh - lastExtLow : na

// Directional OTE zones. Bullish OTE is measured high-to-low; bearish OTE low-to-high.
bullOTEUpper = extRangeValidDecision ? lastExtHigh - decisionRange * 0.618 : na
bullOTELower = extRangeValidDecision ? lastExtHigh - decisionRange * 0.79 : na
bearOTELower = extRangeValidDecision ? lastExtLow + decisionRange * 0.618 : na
bearOTEUpper = extRangeValidDecision ? lastExtLow + decisionRange * 0.79 : na

bullOTEState = extRangeValidDecision and close <= bullOTEUpper and close >= bullOTELower
bearOTEState = extRangeValidDecision and close >= bearOTELower and close <= bearOTEUpper

// Shared engine states consumed by the Decision Engine.
bullLiquidityState = recentSSLSweep
bearLiquidityState = recentBSLSweep
bullDisplacementState = recentBullDisplacement
bearDisplacementState = recentBearDisplacement
bullStructureState = orderFlow == 1 and str.contains(latestStructureEvent, "Bullish")
bearStructureState = orderFlow == -1 and str.contains(latestStructureEvent, "Bearish")
bullOBState = obActive and activeBullish
bearOBState = obActive and not activeBullish
bullFVGState = fvgActive and activeBullish
bearFVGState = fvgActive and not activeBullish
bullHTFState = bullBias
bearHTFState = bearBias

// Decision Engine 2.0 default weights: liquidity 20, displacement 20,
// structure 20, fresh OB 15, active FVG 10, OTE 10, HTF 5.
decisionBullScore = (bullLiquidityState ? 20 : 0) +
     (bullDisplacementState ? 20 : 0) +
     (bullStructureState ? 20 : 0) +
     (bullOBState ? 15 : 0) +
     (bullFVGState ? 10 : 0) +
     (bullOTEState ? 10 : 0) +
     (bullHTFState ? 5 : 0)

decisionBearScore = (bearLiquidityState ? 20 : 0) +
     (bearDisplacementState ? 20 : 0) +
     (bearStructureState ? 20 : 0) +
     (bearOBState ? 15 : 0) +
     (bearFVGState ? 10 : 0) +
     (bearOTEState ? 10 : 0) +
     (bearHTFState ? 5 : 0)

liquidityGateEnabled = requireSweepBeforeBOS or requireSweepBeforeMSS
bullMandatoryReady = bullStructureState and bullDisplacementState and bullOBState and
     (not liquidityGateEnabled or bullLiquidityState) and
     (not requireFVGForSetup or bullFVGState) and
     (not requireOTEForDecision or bullOTEState) and
     (not requireHTFForDecision or bullHTFState)

bearMandatoryReady = bearStructureState and bearDisplacementState and bearOBState and
     (not liquidityGateEnabled or bearLiquidityState) and
     (not requireFVGForSetup or bearFVGState) and
     (not requireOTEForDecision or bearOTEState) and
     (not requireHTFForDecision or bearHTFState)

scoreSeparation = math.abs(decisionBullScore - decisionBearScore)
bothScoresHigh = decisionBullScore >= minimumScore and decisionBearScore >= minimumScore
structureOBConflict = (bullStructureState and bearOBState) or (bearStructureState and bullOBState)
strictHTFConflict = requireHTFForDecision and ((bullStructureState and bearHTFState) or (bearStructureState and bullHTFState))
closeEvidenceConflict = decisionBullScore >= 40 and decisionBearScore >= 40 and scoreSeparation < minimumScoreSeparation
decisionConflict = bothScoresHigh or closeEvidenceConflict or structureOBConflict or strictHTFConflict

decisionLongReady = bullMandatoryReady and decisionBullScore >= minimumScore and
     decisionBullScore > decisionBearScore and scoreSeparation >= minimumScoreSeparation and not decisionConflict
decisionShortReady = bearMandatoryReady and decisionBearScore >= minimumScore and
     decisionBearScore > decisionBullScore and scoreSeparation >= minimumScoreSeparation and not decisionConflict

// Select the side that owns current structure; otherwise use the stronger evidence score.
decisionDirection = orderFlow == 1 ? 1 : orderFlow == -1 ? -1 : decisionBullScore > decisionBearScore ? 1 : decisionBearScore > decisionBullScore ? -1 : 0
decisionScore = decisionLongReady ? decisionBullScore : decisionShortReady ? decisionBearScore :
     decisionDirection == 1 ? decisionBullScore : decisionDirection == -1 ? decisionBearScore : math.max(decisionBullScore, decisionBearScore)

gradeFromDecisionScore(int score) =>
    score >= 95 ? "A+" : score >= 90 ? "A" : score >= 85 ? "B+" : score >= 80 ? "B" : score >= 70 ? "C" : "PASS"

decisionGrade = gradeFromDecisionScore(decisionScore)

string decisionRecommendation = "WAIT"
string decisionMissing = "No valid directional sequence"
string decisionStage = "LIQUIDITY"

if decisionConflict
    decisionRecommendation := "NO TRADE — CONFLICT"
    decisionMissing := structureOBConflict ? "Structure conflicts with the active order block" : strictHTFConflict ? "Higher-timeframe bias conflicts with structure" : bothScoresHigh ? "Bullish and bearish setups both score above the threshold" : "Bullish and bearish evidence is too close"
    decisionStage := "CONFLICT"
else if decisionLongReady
    decisionRecommendation := "BUY"
    decisionMissing := "All required conditions confirmed"
    decisionStage := "ENTRY READY"
else if decisionShortReady
    decisionRecommendation := "SELL"
    decisionMissing := "All required conditions confirmed"
    decisionStage := "ENTRY READY"
else if decisionDirection == 1
    decisionRecommendation := liquidityGateEnabled and not bullLiquidityState ? "WAIT FOR LIQUIDITY" :
         not bullDisplacementState ? "WAIT FOR DISPLACEMENT" :
         not bullStructureState ? "WAIT FOR STRUCTURE" :
         not bullOBState ? "WAIT FOR ORDER BLOCK" :
         requireFVGForSetup and not bullFVGState ? "WAIT FOR FVG" :
         requireOTEForDecision and not bullOTEState ? "WAIT FOR OTE" :
         requireHTFForDecision and not bullHTFState ? "WAIT FOR HTF" : "PREPARING"
    decisionMissing := liquidityGateEnabled and not bullLiquidityState ? "Sell-side liquidity sweep" :
         not bullDisplacementState ? "Bullish displacement" :
         not bullStructureState ? "Bullish BOS / CHoCH" :
         not bullOBState ? "Fresh bullish order block" :
         requireFVGForSetup and not bullFVGState ? "Active bullish FVG" :
         requireOTEForDecision and not bullOTEState ? "Bullish OTE retracement" :
         requireHTFForDecision and not bullHTFState ? "Bullish HTF alignment" : "Score / separation threshold"
    decisionStage := liquidityGateEnabled and not bullLiquidityState ? "LIQUIDITY" :
         not bullDisplacementState ? "DISPLACEMENT" :
         not bullStructureState ? "STRUCTURE" :
         not bullOBState ? "ORDER BLOCK" :
         requireFVGForSetup and not bullFVGState ? "FVG" :
         requireOTEForDecision and not bullOTEState ? "OTE" : "ENTRY"
else if decisionDirection == -1
    decisionRecommendation := liquidityGateEnabled and not bearLiquidityState ? "WAIT FOR LIQUIDITY" :
         not bearDisplacementState ? "WAIT FOR DISPLACEMENT" :
         not bearStructureState ? "WAIT FOR STRUCTURE" :
         not bearOBState ? "WAIT FOR ORDER BLOCK" :
         requireFVGForSetup and not bearFVGState ? "WAIT FOR FVG" :
         requireOTEForDecision and not bearOTEState ? "WAIT FOR OTE" :
         requireHTFForDecision and not bearHTFState ? "WAIT FOR HTF" : "PREPARING"
    decisionMissing := liquidityGateEnabled and not bearLiquidityState ? "Buy-side liquidity sweep" :
         not bearDisplacementState ? "Bearish displacement" :
         not bearStructureState ? "Bearish BOS / CHoCH" :
         not bearOBState ? "Fresh bearish order block" :
         requireFVGForSetup and not bearFVGState ? "Active bearish FVG" :
         requireOTEForDecision and not bearOTEState ? "Bearish OTE retracement" :
         requireHTFForDecision and not bearHTFState ? "Bearish HTF alignment" : "Score / separation threshold"
    decisionStage := liquidityGateEnabled and not bearLiquidityState ? "LIQUIDITY" :
         not bearDisplacementState ? "DISPLACEMENT" :
         not bearStructureState ? "STRUCTURE" :
         not bearOBState ? "ORDER BLOCK" :
         requireFVGForSetup and not bearFVGState ? "FVG" :
         requireOTEForDecision and not bearOTEState ? "OTE" : "ENTRY"

decisionLongSignal = decisionLongReady and not decisionLongReady[1]
decisionShortSignal = decisionShortReady and not decisionShortReady[1]

// Plain-language outputs used by the dashboard and future alerts.
decisionBiasText = decisionDirection == 1 ? "Bullish" : decisionDirection == -1 ? "Bearish" : "Neutral"
decisionNextStep = decisionLongReady ? "Execute only under your trade plan" :
     decisionShortReady ? "Execute only under your trade plan" :
     decisionConflict ? "Wait until directional evidence agrees" :
     decisionDirection == 1 and liquidityGateEnabled and not bullLiquidityState ? "Wait for an SSL sweep" :
     decisionDirection == -1 and liquidityGateEnabled and not bearLiquidityState ? "Wait for a BSL sweep" :
     decisionDirection == 1 and not bullDisplacementState ? "Wait for bullish displacement" :
     decisionDirection == -1 and not bearDisplacementState ? "Wait for bearish displacement" :
     decisionDirection == 1 and not bullStructureState ? "Wait for bullish BOS / CHoCH" :
     decisionDirection == -1 and not bearStructureState ? "Wait for bearish BOS / CHoCH" :
     decisionDirection == 1 and not bullOBState ? "Wait for a fresh bullish order block" :
     decisionDirection == -1 and not bearOBState ? "Wait for a fresh bearish order block" :
     decisionDirection == 1 and requireFVGForSetup and not bullFVGState ? "Wait for an active bullish FVG" :
     decisionDirection == -1 and requireFVGForSetup and not bearFVGState ? "Wait for an active bearish FVG" :
     decisionDirection == 1 and requireOTEForDecision and not bullOTEState ? "Wait for bullish OTE retracement" :
     decisionDirection == -1 and requireOTEForDecision and not bearOTEState ? "Wait for bearish OTE retracement" :
     decisionDirection == 1 and requireHTFForDecision and not bullHTFState ? "Wait for bullish HTF alignment" :
     decisionDirection == -1 and requireHTFForDecision and not bearHTFState ? "Wait for bearish HTF alignment" : "Wait for stronger confirmation"

decisionStory = decisionConflict ? decisionMissing :
     decisionLongReady ? "Bullish setup is fully confirmed" :
     decisionShortReady ? "Bearish setup is fully confirmed" :
     decisionDirection == 1 ? "Bullish evidence is developing" :
     decisionDirection == -1 ? "Bearish evidence is developing" : "No directional setup owns the market"

//=============================================================================
// 13A. MARKET NARRATIVE ENGINE — PR7
// PR7 adds dashboard focus modes without changing BUY / SELL logic.
// PR5 improves dashboard briefing readability without changing BUY / SELL logic.
//=============================================================================
narrativeTrending = math.abs(ema20 - ema50) > atr * 0.25

narrativeBullLiquidityRaid = bullLiquidityState and decisionDirection == 1
narrativeBearLiquidityRaid = bearLiquidityState and decisionDirection == -1

narrativeBullRetracement = decisionDirection == 1 and obActive and activeBullish
narrativeBearRetracement = decisionDirection == -1 and obActive and not activeBullish

narrativeBullExpansion = decisionDirection == 1 and (bullDisplacementState or bullStructureState)
narrativeBearExpansion = decisionDirection == -1 and (bearDisplacementState or bearStructureState)

marketDirectionText = decisionLongReady ? "Bullish" :
     decisionShortReady ? "Bearish" :
     bullBias ? "Bullish" :
     bearBias ? "Bearish" :
     decisionDirection == 1 ? "Bullish Lean" :
     decisionDirection == -1 ? "Bearish Lean" : "Mixed"

marketDirectionColor = str.contains(marketDirectionText, "Bullish") ? bullColor :
     str.contains(marketDirectionText, "Bearish") ? bearColor : neutralColor

marketPhaseText = decisionLongReady or decisionShortReady ? "Execution Ready" :
     decisionConflict ? "Conflict" :
     narrativeBullLiquidityRaid or narrativeBearLiquidityRaid ? "Liquidity Raid" :
     narrativeBullRetracement or narrativeBearRetracement ? "Retracement" :
     narrativeBullExpansion or narrativeBearExpansion ? "Expansion" :
     narrativeTrending ? "Trending" : "Consolidation"

institutionalNarrativeText = decisionLongReady ? "Bullish Execution Setup" :
     decisionShortReady ? "Bearish Execution Setup" :
     decisionConflict ? "Conflict / Stand Down" :
     narrativeBullLiquidityRaid ? "Sell-Side Liquidity Raid" :
     narrativeBearLiquidityRaid ? "Buy-Side Liquidity Raid" :
     narrativeBullRetracement ? "Retracement into Demand" :
     narrativeBearRetracement ? "Retracement into Supply" :
     narrativeBullExpansion ? "Bullish Expansion" :
     narrativeBearExpansion ? "Bearish Expansion" :
     not bullBias and not bearBias and narrativeTrending ? "Repricing" :
     not narrativeTrending ? "Consolidation" : "Transition"

currentObjectiveText = decisionLongReady or decisionShortReady ? "Execute Trade Plan" :
     decisionConflict ? "Stand Down" :
     decisionDirection == 1 and not bullLiquidityState ? "Seek Sell-Side Liquidity" :
     decisionDirection == -1 and not bearLiquidityState ? "Seek Buy-Side Liquidity" :
     decisionDirection == 1 and not bullDisplacementState ? "Create Bullish Displacement" :
     decisionDirection == -1 and not bearDisplacementState ? "Create Bearish Displacement" :
     decisionDirection == 1 and not bullStructureState ? "Confirm Bullish Structure" :
     decisionDirection == -1 and not bearStructureState ? "Confirm Bearish Structure" :
     decisionDirection == 1 and not bullOBState ? "Return to Bullish Order Block" :
     decisionDirection == -1 and not bearOBState ? "Return to Bearish Order Block" :
     decisionDirection == 1 and requireFVGForSetup and not bullFVGState ? "Fill Bullish FVG" :
     decisionDirection == -1 and requireFVGForSetup and not bearFVGState ? "Fill Bearish FVG" :
     decisionDirection == 1 and requireOTEForDecision and not bullOTEState ? "Reach Bullish OTE" :
     decisionDirection == -1 and requireOTEForDecision and not bearOTEState ? "Reach Bearish OTE" :
     "Wait for Directional Clarity"

expectedNextEventText = decisionLongReady or decisionShortReady ? "Manage Trade Plan" :
     decisionConflict ? "Evidence Reset" :
     decisionStage == "LIQUIDITY" ? (decisionDirection == 1 ? "Sweep SSL" : decisionDirection == -1 ? "Sweep BSL" : "Liquidity Sweep") :
     decisionStage == "DISPLACEMENT" ? (decisionDirection == 1 ? "Bullish Displacement" : "Bearish Displacement") :
     decisionStage == "STRUCTURE" ? (decisionDirection == 1 ? "Bullish BOS / CHoCH" : "Bearish BOS / CHoCH") :
     decisionStage == "ORDER BLOCK" ? (decisionDirection == 1 ? "Bullish OB Retest" : "Bearish OB Retest") :
     decisionStage == "FVG" ? (decisionDirection == 1 ? "Bullish FVG" : "Bearish FVG") :
     decisionStage == "OTE" ? "OTE Retracement" :
     decisionStage == "ENTRY" ? (requireConfirmationBreakForEntry ? "Break Confirmation Candle" : "Entry Confirmation") : "Stronger Confirmation"

marketBriefingText = decisionLongReady ? "BUY active. Manage plan. Avoid shorts." :
     decisionShortReady ? "SELL active. Manage plan. Avoid longs." :
     decisionConflict ? "Conflict. Stand down." :
     decisionDirection == 1 and not bullLiquidityState ? "Bullish lean. Wait for SSL." :
     decisionDirection == -1 and not bearLiquidityState ? "Bearish lean. Wait for BSL." :
     decisionDirection == 1 and not bullDisplacementState ? "Bullish build. Need displacement." :
     decisionDirection == -1 and not bearDisplacementState ? "Bearish build. Need displacement." :
     decisionDirection == 1 and not bullStructureState ? "Bullish build. Need BOS / CHoCH." :
     decisionDirection == -1 and not bearStructureState ? "Bearish build. Need BOS / CHoCH." :
     decisionDirection == 1 and not bullOBState ? "Bullish build. Need OB retest." :
     decisionDirection == -1 and not bearOBState ? "Bearish build. Need OB retest." :
     decisionDirection == 1 and requireFVGForSetup and not bullFVGState ? "Bullish build. Need FVG." :
     decisionDirection == -1 and requireFVGForSetup and not bearFVGState ? "Bearish build. Need FVG." :
     decisionDirection == 1 and requireOTEForDecision and not bullOTEState ? "Bullish build. Need OTE." :
     decisionDirection == -1 and requireOTEForDecision and not bearOTEState ? "Bearish build. Need OTE." :
     "No clean story. Wait."

//=============================================================================
// 13B. EXECUTION ENGINE — PR7
// Tracks retests, confirmation candles, confirmation-candle break triggers,
// entry-trigger locks, and de-duplicated visual markers without changing BUY / SELL logic.
// Plot-count fix: debug data-window plots are disabled so the script stays under TradingView's 64-plot limit.
//=============================================================================
executionZoneOverlap(float zoneTop, float zoneBottom) =>
    not na(zoneTop) and not na(zoneBottom) and high >= zoneBottom and low <= zoneTop

bullOBRetestNow = (obActive or obMitigated) and activeBullish and executionZoneOverlap(activeOBTop, activeOBBottom)
bearOBRetestNow = (obActive or obMitigated) and not activeBullish and executionZoneOverlap(activeOBTop, activeOBBottom)

bullFVGRetestNow = (fvgActive or fvgFilled) and activeBullish and executionZoneOverlap(activeFVGTop, activeFVGBottom)
bearFVGRetestNow = (fvgActive or fvgFilled) and not activeBullish and executionZoneOverlap(activeFVGTop, activeFVGBottom)

executionBullRetestSignal = (bullOBRetestNow or bullFVGRetestNow) and not ((bullOBRetestNow[1] == true) or (bullFVGRetestNow[1] == true))
executionBearRetestSignal = (bearOBRetestNow or bearFVGRetestNow) and not ((bearOBRetestNow[1] == true) or (bearFVGRetestNow[1] == true))

var int lastBullOBRetestBar = na
var int lastBearOBRetestBar = na
var int lastBullFVGRetestBar = na
var int lastBearFVGRetestBar = na

if bullOBRetestNow
    lastBullOBRetestBar := bar_index

if bearOBRetestNow
    lastBearOBRetestBar := bar_index

if bullFVGRetestNow
    lastBullFVGRetestBar := bar_index

if bearFVGRetestNow
    lastBearFVGRetestBar := bar_index

recentBullOBRetest = not na(lastBullOBRetestBar) and bar_index - lastBullOBRetestBar <= executionRetestMemoryBars
recentBearOBRetest = not na(lastBearOBRetestBar) and bar_index - lastBearOBRetestBar <= executionRetestMemoryBars
recentBullFVGRetest = not na(lastBullFVGRetestBar) and bar_index - lastBullFVGRetestBar <= executionRetestMemoryBars
recentBearFVGRetest = not na(lastBearFVGRetestBar) and bar_index - lastBearFVGRetestBar <= executionRetestMemoryBars

executionDirectionalOBRetest = decisionDirection == 1 ? recentBullOBRetest :
     decisionDirection == -1 ? recentBearOBRetest :
     recentBullOBRetest or recentBearOBRetest

executionDirectionalFVGRetest = decisionDirection == 1 ? recentBullFVGRetest :
     decisionDirection == -1 ? recentBearFVGRetest :
     recentBullFVGRetest or recentBearFVGRetest

executionRetestText = executionDirectionalOBRetest and executionDirectionalFVGRetest ? "OB + FVG Retest" :
     executionDirectionalOBRetest ? "OB Retest" :
     executionDirectionalFVGRetest ? "FVG Retest" : "No Retest"

//=============================================================================
// 13C. SNIPER MODEL ENGINE PR2 / PR3 — INTERNAL LIQUIDITY SWEEP VALIDATION
// Validates the internal liquidity sweep that occurs during the pullback into
// the active order block / FVG, while keeping protected-level invalidation separate.
// Bearish: internal BSL sweep during pullback is valid; protected high sweep invalidates.
// Bullish: internal SSL sweep during pullback is valid; protected low sweep invalidates.
//=============================================================================
sniperBullPullbackNow = enableSniperModel and activeBullish and (bullOBRetestNow or bullFVGRetestNow)
sniperBearPullbackNow = enableSniperModel and not activeBullish and (bearOBRetestNow or bearFVGRetestNow)

var int sniperBullPullbackStartBar = na
var int sniperBearPullbackStartBar = na
var int sniperBullPullbackZoneBar = na
var int sniperBearPullbackZoneBar = na
var int sniperBullInternalSweepBar = na
var int sniperBearInternalSweepBar = na
var int sniperBullInternalSweepZoneBar = na
var int sniperBearInternalSweepZoneBar = na

if enableSniperModel and bullOBZoneSignal
    sniperBullPullbackStartBar := na
    sniperBullPullbackZoneBar := activeZoneCreatedBar
    sniperBullInternalSweepBar := na
    sniperBullInternalSweepZoneBar := activeZoneCreatedBar

if enableSniperModel and bearOBZoneSignal
    sniperBearPullbackStartBar := na
    sniperBearPullbackZoneBar := activeZoneCreatedBar
    sniperBearInternalSweepBar := na
    sniperBearInternalSweepZoneBar := activeZoneCreatedBar

if sniperBullPullbackNow and (na(sniperBullPullbackStartBar) or sniperBullPullbackZoneBar != activeZoneCreatedBar)
    sniperBullPullbackStartBar := bar_index
    sniperBullPullbackZoneBar := activeZoneCreatedBar

if sniperBearPullbackNow and (na(sniperBearPullbackStartBar) or sniperBearPullbackZoneBar != activeZoneCreatedBar)
    sniperBearPullbackStartBar := bar_index
    sniperBearPullbackZoneBar := activeZoneCreatedBar

sniperBullPullbackActive = enableSniperModel and not na(sniperBullPullbackStartBar) and
     (na(sniperBullPullbackZoneBar) or na(activeZoneCreatedBar) or sniperBullPullbackZoneBar == activeZoneCreatedBar) and
     (bar_index - sniperBullPullbackStartBar <= sniperInternalSweepMemoryBars) and
     not sniperBullSetupInvalidated

sniperBearPullbackActive = enableSniperModel and not na(sniperBearPullbackStartBar) and
     (na(sniperBearPullbackZoneBar) or na(activeZoneCreatedBar) or sniperBearPullbackZoneBar == activeZoneCreatedBar) and
     (bar_index - sniperBearPullbackStartBar <= sniperInternalSweepMemoryBars) and
     not sniperBearSetupInvalidated

sniperBullInternalSSLSweepNow = sniperBullPullbackActive and internalSSLSweep and not sniperBullProtectedLowSweptNow
sniperBearInternalBSLSweepNow = sniperBearPullbackActive and internalBSLSweep and not sniperBearProtectedHighSweptNow

if sniperBullInternalSSLSweepNow
    sniperBullInternalSweepBar := bar_index
    sniperBullInternalSweepZoneBar := activeZoneCreatedBar

if sniperBearInternalBSLSweepNow
    sniperBearInternalSweepBar := bar_index
    sniperBearInternalSweepZoneBar := activeZoneCreatedBar

sniperBullInternalSweepValid = enableSniperModel and not sniperBullSetupInvalidated and
     not na(sniperBullInternalSweepBar) and
     bar_index - sniperBullInternalSweepBar <= sniperInternalSweepMemoryBars and
     (na(sniperBullInternalSweepZoneBar) or na(activeZoneCreatedBar) or sniperBullInternalSweepZoneBar == activeZoneCreatedBar)

sniperBearInternalSweepValid = enableSniperModel and not sniperBearSetupInvalidated and
     not na(sniperBearInternalSweepBar) and
     bar_index - sniperBearInternalSweepBar <= sniperInternalSweepMemoryBars and
     (na(sniperBearInternalSweepZoneBar) or na(activeZoneCreatedBar) or sniperBearInternalSweepZoneBar == activeZoneCreatedBar)

sniperBullSweepText = sniperBullSetupInvalidated ? "Bull PL swept / reset" :
     sniperBullInternalSweepValid ? "Internal SSL swept ✓" :
     sniperBullPullbackActive ? "Need internal SSL" :
     "Waiting for pullback"

sniperBearSweepText = sniperBearSetupInvalidated ? "Bear PH swept / reset" :
     sniperBearInternalSweepValid ? "Internal BSL swept ✓" :
     sniperBearPullbackActive ? "Need internal BSL" :
     "Waiting for pullback"

sniperInternalSweepText = orderFlow == -1 ? sniperBearSweepText :
     orderFlow == 1 ? sniperBullSweepText :
     sniperBearPullbackActive or sniperBearInternalSweepValid ? sniperBearSweepText :
     sniperBullPullbackActive or sniperBullInternalSweepValid ? sniperBullSweepText : "Waiting for pullback"

sniperInternalSweepColor = str.contains(sniperInternalSweepText, "reset") ? bearColor :
     str.contains(sniperInternalSweepText, "✓") ? bullColor :
     str.contains(sniperInternalSweepText, "Need") ? liqColor : neutralColor

//=============================================================================
// 13D. SNIPER MODEL ENGINE PR3 — HTF LIQUIDITY ZONE CONTEXT
// Higher timeframe finds the battlefield; lower timeframe finds the sniper entry.
// This classifies the active parent zone as bullish demand, bearish supply, or waiting,
// then pairs that zone with the expected liquidity side.
//=============================================================================
sniperActiveParentZone = enableSniperModel and (obActive or fvgActive or obMitigated or fvgFilled)

sniperBullZoneContext = sniperActiveParentZone and activeBullish
sniperBearZoneContext = sniperActiveParentZone and not activeBullish

sniperBullHTFBiasOK = not sniperRequireHTFBiasForContext or bullBias or htfStructureBull
sniperBearHTFBiasOK = not sniperRequireHTFBiasForContext or bearBias or htfStructureBear

sniperBullLiquidityNearZone = recentSSLSweep or liquidityLevelNearActiveOB(lastSSLSweepLevel)
sniperBearLiquidityNearZone = recentBSLSweep or liquidityLevelNearActiveOB(lastBSLSweepLevel)

sniperBullHTFContextCandidate = sniperBullZoneContext and sniperBullHTFBiasOK and not sniperBullSetupInvalidated
sniperBearHTFContextCandidate = sniperBearZoneContext and sniperBearHTFBiasOK and not sniperBearSetupInvalidated

sniperBullHTFContextReady = sniperBullHTFContextCandidate and sniperBullLiquidityNearZone and not sniperBullSetupInvalidated
sniperBearHTFContextReady = sniperBearHTFContextCandidate and sniperBearLiquidityNearZone and not sniperBearSetupInvalidated

var int sniperHTFContextDirection = 0
var int sniperHTFContextBar = na
var int sniperHTFContextZoneBar = na
var string sniperHTFContextLastText = "Waiting"

if sniperBullHTFContextReady
    sniperHTFContextDirection := 1
    sniperHTFContextBar := bar_index
    sniperHTFContextZoneBar := activeZoneCreatedBar
    sniperHTFContextLastText := "Bullish Demand / SSL Below ✓"

if sniperBearHTFContextReady
    sniperHTFContextDirection := -1
    sniperHTFContextBar := bar_index
    sniperHTFContextZoneBar := activeZoneCreatedBar
    sniperHTFContextLastText := "Bearish Supply / BSL Above ✓"

sniperHTFContextFresh = enableSniperModel and not na(sniperHTFContextBar) and
     bar_index - sniperHTFContextBar <= sniperHTFContextMemoryBars and
     (na(sniperHTFContextZoneBar) or na(activeZoneCreatedBar) or sniperHTFContextZoneBar == activeZoneCreatedBar)

sniperHTFZoneClassText = not sniperActiveParentZone ? "Waiting" :
     sniperBullZoneContext ? "Bullish Demand" :
     sniperBearZoneContext ? "Bearish Supply" : "Waiting"

sniperBullHTFContextText = sniperBullSetupInvalidated ? "Bullish Demand / PL swept" :
     sniperBullHTFContextReady ? "Bullish Demand / SSL Below ✓" :
     sniperBullHTFContextCandidate ? "Bullish Demand / Need SSL" :
     sniperBullZoneContext ? "Bullish Demand / Need HTF" : "Waiting"

sniperBearHTFContextText = sniperBearSetupInvalidated ? "Bearish Supply / PH swept" :
     sniperBearHTFContextReady ? "Bearish Supply / BSL Above ✓" :
     sniperBearHTFContextCandidate ? "Bearish Supply / Need BSL" :
     sniperBearZoneContext ? "Bearish Supply / Need HTF" : "Waiting"

sniperHTFContextText = not enableSniperModel ? "Sniper disabled" :
     orderFlow == -1 ? sniperBearHTFContextText :
     orderFlow == 1 ? sniperBullHTFContextText :
     sniperHTFContextFresh ? sniperHTFContextLastText :
     sniperBearZoneContext ? sniperBearHTFContextText :
     sniperBullZoneContext ? sniperBullHTFContextText : "Waiting for parent zone"

sniperHTFContextColor = str.contains(sniperHTFContextText, "swept") ? bearColor :
     str.contains(sniperHTFContextText, "Bearish Supply") ? bearColor :
     str.contains(sniperHTFContextText, "Bullish Demand") ? bullColor :
     str.contains(sniperHTFContextText, "Need") ? liqColor : neutralColor

// Confirmation candle logic.
// Bullish confirmation requires a bullish candle after/inside a bullish retest zone.
// Bearish confirmation requires a bearish candle after/inside a bearish retest zone.
executionCandleRange = math.max(high - low, syminfo.mintick)

bullExecutionRejection = close > open and (math.min(open, close) - low) / executionCandleRange >= 0.30
bearExecutionRejection = close < open and (high - math.max(open, close)) / executionCandleRange >= 0.30

bullConfirmationNow = decisionDirection == 1 and (recentBullOBRetest or recentBullFVGRetest) and bullExecutionRejection
bearConfirmationNow = decisionDirection == -1 and (recentBearOBRetest or recentBearFVGRetest) and bearExecutionRejection

executionBullConfirmationSignal = bullConfirmationNow and not (bullConfirmationNow[1] == true)
executionBearConfirmationSignal = bearConfirmationNow and not (bearConfirmationNow[1] == true)

var int lastBullConfirmationBar = na
var int lastBearConfirmationBar = na

if bullConfirmationNow
    lastBullConfirmationBar := bar_index

if bearConfirmationNow
    lastBearConfirmationBar := bar_index

recentBullConfirmation = not na(lastBullConfirmationBar) and bar_index - lastBullConfirmationBar <= executionRetestMemoryBars
recentBearConfirmation = not na(lastBearConfirmationBar) and bar_index - lastBearConfirmationBar <= executionRetestMemoryBars

executionDirectionalConfirmation = decisionDirection == 1 ? recentBullConfirmation :
     decisionDirection == -1 ? recentBearConfirmation :
     recentBullConfirmation or recentBearConfirmation

executionConfirmationText = recentBullConfirmation ? "Bullish Confirmation" :
     recentBearConfirmation ? "Bearish Confirmation" : "Waiting"

// PR7 Confirmation Candle Break Trigger.
// A confirmation candle arms the setup. The entry trigger fires only after price
// breaks that confirmation candle high/low, then PR6 locks the first trigger per zone.
var float bullEntryConfirmationHigh = na
var float bullEntryConfirmationLow = na
var int bullEntryConfirmationBar = na
var int bullEntryConfirmationZoneBar = na

var float bearEntryConfirmationHigh = na
var float bearEntryConfirmationLow = na
var int bearEntryConfirmationBar = na
var int bearEntryConfirmationZoneBar = na

if executionBullConfirmationSignal
    bullEntryConfirmationHigh := high
    bullEntryConfirmationLow := low
    bullEntryConfirmationBar := bar_index
    bullEntryConfirmationZoneBar := activeZoneCreatedBar

if executionBearConfirmationSignal
    bearEntryConfirmationHigh := high
    bearEntryConfirmationLow := low
    bearEntryConfirmationBar := bar_index
    bearEntryConfirmationZoneBar := activeZoneCreatedBar

bullEntryConfirmationReady = not na(bullEntryConfirmationBar) and bar_index - bullEntryConfirmationBar <= confirmationBreakMemoryBars and
     (na(bullEntryConfirmationZoneBar) or na(activeZoneCreatedBar) or bullEntryConfirmationZoneBar == activeZoneCreatedBar)

bearEntryConfirmationReady = not na(bearEntryConfirmationBar) and bar_index - bearEntryConfirmationBar <= confirmationBreakMemoryBars and
     (na(bearEntryConfirmationZoneBar) or na(activeZoneCreatedBar) or bearEntryConfirmationZoneBar == activeZoneCreatedBar)

bullConfirmationBreakArmed = bullEntryConfirmationReady and bar_index > bullEntryConfirmationBar
bearConfirmationBreakArmed = bearEntryConfirmationReady and bar_index > bearEntryConfirmationBar

bullConfirmationHighBroken = not na(bullEntryConfirmationHigh) and (
     entryTriggerBreakMode == "Close Break" ?
     close > bullEntryConfirmationHigh and close[1] <= bullEntryConfirmationHigh :
     high > bullEntryConfirmationHigh and high[1] <= bullEntryConfirmationHigh
)

bearConfirmationLowBroken = not na(bearEntryConfirmationLow) and (
     entryTriggerBreakMode == "Close Break" ?
     close < bearEntryConfirmationLow and close[1] >= bearEntryConfirmationLow :
     low < bearEntryConfirmationLow and low[1] >= bearEntryConfirmationLow
)

bullConfirmationBreakCandidate = decisionDirection == 1 and bullConfirmationBreakArmed and bullConfirmationHighBroken and
     not decisionConflict and (recentBullOBRetest or recentBullFVGRetest)

bearConfirmationBreakCandidate = decisionDirection == -1 and bearConfirmationBreakArmed and bearConfirmationLowBroken and
     not decisionConflict and (recentBearOBRetest or recentBearFVGRetest)

// Optional fallback preserves PR6 behavior when the new break trigger is disabled.
bullImmediateConfirmationCandidate = decisionDirection == 1 and executionBullConfirmationSignal and not decisionConflict and (recentBullOBRetest or recentBullFVGRetest)
bearImmediateConfirmationCandidate = decisionDirection == -1 and executionBearConfirmationSignal and not decisionConflict and (recentBearOBRetest or recentBearFVGRetest)

bullEntryTriggerCandidate = requireConfirmationBreakForEntry ? bullConfirmationBreakCandidate : bullImmediateConfirmationCandidate
bearEntryTriggerCandidate = requireConfirmationBreakForEntry ? bearConfirmationBreakCandidate : bearImmediateConfirmationCandidate

var int lastBullEntryTriggerBar = na
var int lastBearEntryTriggerBar = na
var int lastBullEntryTriggerZoneBar = na
var int lastBearEntryTriggerZoneBar = na
var string lastEntryTriggerSide = "None"

bullEntryTriggerZoneOpen = not entryTriggerLockEnabled or na(activeZoneCreatedBar) or na(lastBullEntryTriggerZoneBar) or lastBullEntryTriggerZoneBar != activeZoneCreatedBar
bearEntryTriggerZoneOpen = not entryTriggerLockEnabled or na(activeZoneCreatedBar) or na(lastBearEntryTriggerZoneBar) or lastBearEntryTriggerZoneBar != activeZoneCreatedBar

executionBullEntryTriggerSignal = bullEntryTriggerCandidate and bullEntryTriggerZoneOpen
executionBearEntryTriggerSignal = bearEntryTriggerCandidate and bearEntryTriggerZoneOpen

if executionBullEntryTriggerSignal
    lastBullEntryTriggerBar := bar_index
    lastBullEntryTriggerZoneBar := activeZoneCreatedBar
    lastEntryTriggerSide := "Long"

if executionBearEntryTriggerSignal
    lastBearEntryTriggerBar := bar_index
    lastBearEntryTriggerZoneBar := activeZoneCreatedBar
    lastEntryTriggerSide := "Short"

bullCurrentZoneLocked = entryTriggerLockEnabled and not na(activeZoneCreatedBar) and not na(lastBullEntryTriggerZoneBar) and lastBullEntryTriggerZoneBar == activeZoneCreatedBar
bearCurrentZoneLocked = entryTriggerLockEnabled and not na(activeZoneCreatedBar) and not na(lastBearEntryTriggerZoneBar) and lastBearEntryTriggerZoneBar == activeZoneCreatedBar

executionCurrentZoneLocked = decisionDirection == 1 ? bullCurrentZoneLocked :
     decisionDirection == -1 ? bearCurrentZoneLocked :
     bullCurrentZoneLocked or bearCurrentZoneLocked

executionTriggerActive = executionBullEntryTriggerSignal or executionBearEntryTriggerSignal
executionBreakArmed = requireConfirmationBreakForEntry and (
     decisionDirection == 1 ? bullConfirmationBreakArmed :
     decisionDirection == -1 ? bearConfirmationBreakArmed :
     bullConfirmationBreakArmed or bearConfirmationBreakArmed
)
executionSetupForming = (executionDirectionalOBRetest or executionDirectionalFVGRetest) and not executionDirectionalConfirmation and not executionCurrentZoneLocked

executionEntryLockText = executionTriggerActive ? "Entry Break Trigger Active" :
     executionCurrentZoneLocked ? "Entry Used / Locked" :
     executionBreakArmed ? "Break Confirmation Candle" :
     executionDirectionalConfirmation ? "Confirmation Ready" :
     executionSetupForming ? "Setup Forming" : "Waiting"

executionStatusText = decisionConflict ? "Stand Down" :
     executionTriggerActive ? "Entry Trigger" :
     executionCurrentZoneLocked ? "Entry Used" :
     decisionLongReady or decisionShortReady ? "Triggered" :
     executionBreakArmed ? "Break Armed" :
     executionDirectionalConfirmation ? "Confirmation" :
     executionDirectionalOBRetest or executionDirectionalFVGRetest ? "Retesting" :
     decisionDirection == 1 or decisionDirection == -1 ? "Preparing" : "Not Ready"

executionEntryPermissionText = executionBullEntryTriggerSignal ? "Long Trigger" :
     executionBearEntryTriggerSignal ? "Short Trigger" :
     executionCurrentZoneLocked ? "Entry Used / Locked" :
     executionBreakArmed ? "Break Confirmation" :
     executionDirectionalConfirmation ? "Confirmation Ready" :
     executionSetupForming ? "Setup Forming" : "Wait"

executionStatusValue = executionStatusText == "Triggered" ? 7 :
     executionStatusText == "Entry Trigger" ? 6 :
     executionStatusText == "Entry Used" ? 5 :
     executionStatusText == "Break Armed" ? 4 :
     executionStatusText == "Confirmation" ? 3 :
     executionStatusText == "Retesting" ? 2 :
     executionStatusText == "Preparing" ? 1 : 0

executionEntryPermissionValue = executionEntryPermissionText == "Long Trigger" ? 2 :
     executionEntryPermissionText == "Short Trigger" ? -2 :
     executionEntryPermissionText == "Break Confirmation" ? 1.5 :
     executionEntryPermissionText == "Confirmation Ready" ? 1 :
     executionEntryPermissionText == "Entry Used / Locked" ? 0.5 : 0

// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionDirectionalOBRetest ? 1 : 0) : na, "Execution OB Retest", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionDirectionalFVGRetest ? 1 : 0) : na, "Execution FVG Retest", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionDirectionalConfirmation ? 1 : 0) : na, "Execution Confirmation", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBreakArmed ? 1 : 0) : na, "Execution Confirmation Break Armed", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (bullConfirmationBreakCandidate ? 1 : bearConfirmationBreakCandidate ? -1 : 0) : na, "Execution Confirmation Break Candidate", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug and requireConfirmationBreakForEntry ? bullEntryConfirmationHigh : na, "Bullish confirmation break high", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug and requireConfirmationBreakForEntry ? bearEntryConfirmationLow : na, "Bearish confirmation break low", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? executionStatusValue : na, "Execution Status Value", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? executionEntryPermissionValue : na, "Execution Entry Permission", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBullEntryTriggerSignal ? 1 : executionBearEntryTriggerSignal ? -1 : 0) : na, "Execution Entry Trigger Signal", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionCurrentZoneLocked ? 1 : 0) : na, "Execution Entry Zone Locked", display = display.data_window)

// PR8 visual de-duplication.
// Execution states still update normally; only repeated chart markers are filtered.
var int lastBullRetestMarkerBar = na
var int lastBearRetestMarkerBar = na
var int lastBullConfirmationMarkerBar = na
var int lastBearConfirmationMarkerBar = na
var int lastBullRetestMarkerZoneBar = na
var int lastBearRetestMarkerZoneBar = na
var int lastBullConfirmationMarkerZoneBar = na
var int lastBearConfirmationMarkerZoneBar = na

bullRetestMarkerCooldownOK = na(lastBullRetestMarkerBar) or bar_index - lastBullRetestMarkerBar > executionMarkerCooldownBars
bearRetestMarkerCooldownOK = na(lastBearRetestMarkerBar) or bar_index - lastBearRetestMarkerBar > executionMarkerCooldownBars
bullConfirmationMarkerCooldownOK = na(lastBullConfirmationMarkerBar) or bar_index - lastBullConfirmationMarkerBar > executionMarkerCooldownBars
bearConfirmationMarkerCooldownOK = na(lastBearConfirmationMarkerBar) or bar_index - lastBearConfirmationMarkerBar > executionMarkerCooldownBars

bullRetestMarkerZoneOK = not executionMarkersOncePerZone or na(activeZoneCreatedBar) or na(lastBullRetestMarkerZoneBar) or lastBullRetestMarkerZoneBar != activeZoneCreatedBar
bearRetestMarkerZoneOK = not executionMarkersOncePerZone or na(activeZoneCreatedBar) or na(lastBearRetestMarkerZoneBar) or lastBearRetestMarkerZoneBar != activeZoneCreatedBar
bullConfirmationMarkerZoneOK = not executionMarkersOncePerZone or na(activeZoneCreatedBar) or na(lastBullConfirmationMarkerZoneBar) or lastBullConfirmationMarkerZoneBar != activeZoneCreatedBar
bearConfirmationMarkerZoneOK = not executionMarkersOncePerZone or na(activeZoneCreatedBar) or na(lastBearConfirmationMarkerZoneBar) or lastBearConfirmationMarkerZoneBar != activeZoneCreatedBar

executionBullRetestMarkerSignal = executionBullRetestSignal and bullRetestMarkerCooldownOK and bullRetestMarkerZoneOK
executionBearRetestMarkerSignal = executionBearRetestSignal and bearRetestMarkerCooldownOK and bearRetestMarkerZoneOK
executionBullConfirmationMarkerSignal = executionBullConfirmationSignal and bullConfirmationMarkerCooldownOK and bullConfirmationMarkerZoneOK
executionBearConfirmationMarkerSignal = executionBearConfirmationSignal and bearConfirmationMarkerCooldownOK and bearConfirmationMarkerZoneOK

if executionBullRetestMarkerSignal
    lastBullRetestMarkerBar := bar_index
    lastBullRetestMarkerZoneBar := activeZoneCreatedBar

if executionBearRetestMarkerSignal
    lastBearRetestMarkerBar := bar_index
    lastBearRetestMarkerZoneBar := activeZoneCreatedBar

if executionBullConfirmationMarkerSignal
    lastBullConfirmationMarkerBar := bar_index
    lastBullConfirmationMarkerZoneBar := activeZoneCreatedBar

if executionBearConfirmationMarkerSignal
    lastBearConfirmationMarkerBar := bar_index
    lastBearConfirmationMarkerZoneBar := activeZoneCreatedBar

// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBullRetestMarkerSignal ? 1 : 0) : na, "Bullish execution retest marker allowed", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBearRetestMarkerSignal ? 1 : 0) : na, "Bearish execution retest marker allowed", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBullConfirmationMarkerSignal ? 1 : 0) : na, "Bullish execution confirmation marker allowed", display = display.data_window)
// Disabled debug data-window plot to stay under TradingView 64-plot limit: plot(showExecutionDebug ? (executionBearConfirmationMarkerSignal ? 1 : 0) : na, "Bearish execution confirmation marker allowed", display = display.data_window)

plotshape(showExecutionRetestMarkers and visualMode != "Minimal" and (labelModeFull or labelModeShort) and executionBullRetestMarkerSignal, "Bullish execution retest marker RT", shape.circle, location.belowbar, bullColor, size = size.tiny, text = "RT", textcolor = color.white)
plotshape(showExecutionRetestMarkers and visualMode != "Minimal" and (labelModeFull or labelModeShort) and executionBearRetestMarkerSignal, "Bearish execution retest marker RT", shape.circle, location.abovebar, bearColor, size = size.tiny, text = "RT", textcolor = color.white)
plotshape(showExecutionRetestMarkers and visualMode != "Minimal" and labelModeMinimal and executionBullRetestMarkerSignal, "Bullish execution retest marker R", shape.circle, location.belowbar, bullColor, size = size.tiny, text = "R", textcolor = color.white)
plotshape(showExecutionRetestMarkers and visualMode != "Minimal" and labelModeMinimal and executionBearRetestMarkerSignal, "Bearish execution retest marker R", shape.circle, location.abovebar, bearColor, size = size.tiny, text = "R", textcolor = color.white)

plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeFull and executionBullConfirmationMarkerSignal, "Bullish execution confirmation marker CONF", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "CONF", textcolor = color.white)
plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeFull and executionBearConfirmationMarkerSignal, "Bearish execution confirmation marker CONF", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "CONF", textcolor = color.white)
plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeShort and executionBullConfirmationMarkerSignal, "Bullish execution confirmation marker CNF", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "CNF", textcolor = color.white)
plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeShort and executionBearConfirmationMarkerSignal, "Bearish execution confirmation marker CNF", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "CNF", textcolor = color.white)
plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeMinimal and executionBullConfirmationMarkerSignal, "Bullish execution confirmation marker C", shape.labelup, location.belowbar, bullColor, size = size.tiny, text = "C", textcolor = color.white)
plotshape(showExecutionConfirmationMarkers and visualMode != "Minimal" and labelModeMinimal and executionBearConfirmationMarkerSignal, "Bearish execution confirmation marker C", shape.labeldown, location.abovebar, bearColor, size = size.tiny, text = "C", textcolor = color.white)

plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeFull and executionBullEntryTriggerSignal, "Bullish execution entry trigger marker TRIGGER", shape.diamond, location.belowbar, bullColor, size = size.small, text = "TRIGGER", textcolor = color.white)
plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeFull and executionBearEntryTriggerSignal, "Bearish execution entry trigger marker TRIGGER", shape.diamond, location.abovebar, bearColor, size = size.small, text = "TRIGGER", textcolor = color.white)
plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeShort and executionBullEntryTriggerSignal, "Bullish execution entry trigger marker TRG", shape.diamond, location.belowbar, bullColor, size = size.tiny, text = "TRG", textcolor = color.white)
plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeShort and executionBearEntryTriggerSignal, "Bearish execution entry trigger marker TRG", shape.diamond, location.abovebar, bearColor, size = size.tiny, text = "TRG", textcolor = color.white)
plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeMinimal and executionBullEntryTriggerSignal, "Bullish execution entry trigger marker T", shape.diamond, location.belowbar, bullColor, size = size.tiny, text = "T", textcolor = color.white)
plotshape(showExecutionEntryTriggerMarkers and visualMode != "Minimal" and labelModeMinimal and executionBearEntryTriggerSignal, "Bearish execution entry trigger marker T", shape.diamond, location.abovebar, bearColor, size = size.tiny, text = "T", textcolor = color.white)

//=============================================================================
// 13. TRADE PLAN
//=============================================================================
var line entryLine = na
var line stopLine = na
var line targetLine = na
var label tradeLabel = na
var float lastPlanEntry = na
var float lastPlanStop = na
var float lastPlanTarget = na
var float lastPlanRR = na
var string lastPlanDirection = "WAIT"

clearTradePlan() =>
    line.delete(entryLine)
    line.delete(stopLine)
    line.delete(targetLine)
    label.delete(tradeLabel)

if showTradePlan and decisionLongSignal
    clearTradePlan()

    float entry = entryMode == "OB Proximal" ? activeOBTop :
         entryMode == "FVG Midpoint" and fvgActive ? (activeFVGTop + activeFVGBottom) / 2.0 :
         (activeOBTop + activeOBBottom) / 2.0

    float stop = activeOBBottom - atr * stopBufferATR
    float risk = math.max(entry - stop, syminfo.mintick)
    float target = entry + risk * targetRR
    lastPlanEntry := entry
    lastPlanStop := stop
    lastPlanTarget := target
    lastPlanRR := targetRR
    lastPlanDirection := "LONG"

    entryLine := line.new(bar_index, entry, bar_index + 20, entry, xloc = xloc.bar_index, color = color.white, style = line.style_dashed)
    stopLine := line.new(bar_index, stop, bar_index + 20, stop, xloc = xloc.bar_index, color = bearColor, style = line.style_dotted)
    targetLine := line.new(bar_index, target, bar_index + 20, target, xloc = xloc.bar_index, color = bullColor, style = line.style_dotted)
    tradeLabel := label.new(
         bar_index + 20, entry,
         "BUY  " + str.tostring(decisionScore) + "%\nE " + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(stop, format.mintick) +
         "\nTP " + str.tostring(target, format.mintick),
         xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_left, color = bullColor, textcolor = color.white
     )

if showTradePlan and decisionShortSignal
    clearTradePlan()

    float entry = entryMode == "OB Proximal" ? activeOBBottom :
         entryMode == "FVG Midpoint" and fvgActive ? (activeFVGTop + activeFVGBottom) / 2.0 :
         (activeOBTop + activeOBBottom) / 2.0

    float stop = activeOBTop + atr * stopBufferATR
    float risk = math.max(stop - entry, syminfo.mintick)
    float target = entry - risk * targetRR
    lastPlanEntry := entry
    lastPlanStop := stop
    lastPlanTarget := target
    lastPlanRR := targetRR
    lastPlanDirection := "SHORT"

    entryLine := line.new(bar_index, entry, bar_index + 20, entry, xloc = xloc.bar_index, color = color.white, style = line.style_dashed)
    stopLine := line.new(bar_index, stop, bar_index + 20, stop, xloc = xloc.bar_index, color = bearColor, style = line.style_dotted)
    targetLine := line.new(bar_index, target, bar_index + 20, target, xloc = xloc.bar_index, color = bullColor, style = line.style_dotted)
    tradeLabel := label.new(
         bar_index + 20, entry,
         "SELL  " + str.tostring(decisionScore) + "%\nE " + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(stop, format.mintick) +
         "\nTP " + str.tostring(target, format.mintick),
         xloc = xloc.bar_index, yloc = yloc.price,
         style = label.style_label_left, color = bearColor, textcolor = color.white
     )

// Remove stale plans as soon as the centralized decision is no longer BUY or SELL.
if lastPlanDirection != "WAIT" and not decisionLongReady and not decisionShortReady
    clearTradePlan()
    entryLine := na
    stopLine := na
    targetLine := na
    tradeLabel := na
    lastPlanEntry := na
    lastPlanStop := na
    lastPlanTarget := na
    lastPlanRR := na
    lastPlanDirection := "WAIT"

plotshape(showSetupArrows and visualMode != "Minimal" and decisionLongSignal, "Qualified bullish Genesis setup", shape.triangleup, location.belowbar, bullColor, size = size.small, text = "ICE")
plotshape(showSetupArrows and visualMode != "Minimal" and decisionShortSignal, "Qualified bearish Genesis setup", shape.triangledown, location.abovebar, bearColor, size = size.small, text = "ICE")

//=============================================================================
// 14. OPTIONAL HTF LEVELS
//=============================================================================
plot(showHTFLevels ? htfProtectedHigh : na, "HTF Protected High", color = color.new(bearColor, 65), style = plot.style_linebr)
plot(showHTFLevels ? htfProtectedLow : na, "HTF Protected Low", color = color.new(bullColor, 65), style = plot.style_linebr)

//=============================================================================
// 15. INSTITUTIONAL DASHBOARD
//=============================================================================
// Decision Engine owns the user-facing score, grade, and recommendation.
lastScore = decisionScore
lastDecision = decisionRecommendation
lastGrade = decisionGrade

flowText = orderFlow == 1 ? "Bullish" : orderFlow == -1 ? "Bearish" : "Undetermined"
zoneText = obActive ? (activeBullish ? "Bullish OB" : "Bearish OB") : "Waiting"
fvgText = fvgActive ? (activeBullish ? "Bullish FVG" : "Bearish FVG") : "Waiting"
marketStateText = math.abs(ema20 - ema50) > atr * 0.25 ? "Trending" : "Ranging"
extRangeValid = not na(lastExtHigh) and not na(lastExtLow) and lastExtHigh > lastExtLow
rangeMid = extRangeValid ? (lastExtHigh + lastExtLow) / 2.0 : na
premiumDiscountText = not extRangeValid ? "Unknown" : close >= rangeMid ? "Premium" : "Discount"
oteHigh = extRangeValid ? lastExtHigh : na
oteLow = extRangeValid ? lastExtLow : na
ote79 = extRangeValid ? oteHigh - (oteHigh - oteLow) * 0.79 : na
ote618 = extRangeValid ? oteHigh - (oteHigh - oteLow) * 0.618 : na

check(bool condition, string yesText, string noText) => condition ? "●  " + yesText : "○  " + noText
dashboardEnabled = showDashboard and dashboardMode != "Off"
isFull = dashboardMode == "Full"
isMorningBrief = dashboardMode == "Morning Brief"
isExecutionFocus = dashboardMode == "Execution"
isTradeManagement = dashboardMode == "Trade Management"
isCompact = dashboardMode == "Compact"
isMinimal = dashboardMode == "Minimal"
var table dash = table.new(position.top_right, 2, 34, border_width = 1, border_color = color.new(neutralColor, 65))

if barstate.islast
    table.clear(dash, 0, 0, 1, 33)

    if dashboardEnabled
        bool directionBull = decisionDirection == 1
        bool dashboardDisplacement = directionBull ? recentBullDisplacement : recentBearDisplacement
        bool dashboardOTE = extRangeValid and close <= ote618 and close >= ote79
        string compactMarket = marketDirectionText + " / " + marketPhaseText
        string compactLiqDisp = (directionBull ? (recentSSLSweep ? "SSL ✓" : "SSL …") : (recentBSLSweep ? "BSL ✓" : "BSL …")) + " / " + (dashboardDisplacement ? "Disp ✓" : "Disp …")
        string compactStructOB = latestStructureEvent + " / " + (obActive ? zoneText : "OB …")
        string compactFvgOTE = (fvgActive ? fvgText : "FVG …") + " / " + (dashboardOTE ? "OTE ✓" : "OTE …")
        string compactScore = str.tostring(lastScore) + "% / " + lastGrade
        color decisionColor = lastDecision == "BUY" ? bullColor : lastDecision == "SELL" ? bearColor : neutralColor
        color executionEntryPermissionColor = executionEntryPermissionText == "Long Trigger" ? bullColor : executionEntryPermissionText == "Short Trigger" ? bearColor : (executionEntryPermissionText == "Confirmation Ready" or executionEntryPermissionText == "Break Confirmation") ? liqColor : neutralColor
        string dashboardHtfSession = biasText + " / " + activeSessionText
        string dashboardPlanText = showSmartTradePanel and lastPlanDirection != "WAIT" ? lastPlanDirection : "No active plan"
        string dashboardEntryStop = showSmartTradePanel and not na(lastPlanEntry) and not na(lastPlanStop) ? str.tostring(lastPlanEntry, format.mintick) + " / " + str.tostring(lastPlanStop, format.mintick) : "—"
        string dashboardTargetRR = showSmartTradePanel and not na(lastPlanTarget) and not na(lastPlanRR) ? str.tostring(lastPlanTarget, format.mintick) + " / 1:" + str.tostring(lastPlanRR, "#.##") : "—"

        if isMorningBrief
            table.cell(dash, 0, 0, "ICE GENESIS", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 1, 0, "v1.0 ZZ PR3", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 0, 1, "MORNING BRIEF", text_color = color.white, bgcolor = color.new(color.black, 0))
            table.cell(dash, 1, 1, "", bgcolor = color.new(color.black, 0))

            table.cell(dash, 0, 2, "Direction", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 2, marketDirectionText, text_color = marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 3, "Narrative", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 3, institutionalNarrativeText, text_color = marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 4, "Phase", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 4, marketPhaseText, text_color = marketPhaseText == "Conflict" ? bearColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 5, "Briefing", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 5, marketBriefingText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.small)

            table.cell(dash, 0, 6, "Decision", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 6, lastDecision, text_color = decisionColor, bgcolor = panelColor, text_size = size.large)

            table.cell(dash, 0, 7, "Score / Grade", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 7, compactScore, text_color = lastScore >= minimumScore ? bullColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 8, "Objective", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 8, currentObjectiveText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 9, "Next Event", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 9, expectedNextEventText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 10, "Session", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 10, activeSessionText, text_color = activeSessionText != "Inactive" ? bullColor : neutralColor, bgcolor = panelColor)

        else if isExecutionFocus
            table.cell(dash, 0, 0, "ICE GENESIS", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 1, 0, "v1.0 ZZ PR3", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 0, 1, "EXECUTION FOCUS", text_color = color.white, bgcolor = color.new(color.black, 0))
            table.cell(dash, 1, 1, lastDecision, text_color = decisionColor, bgcolor = color.new(color.black, 0), text_size = size.large)

            table.cell(dash, 0, 2, "Liquidity", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 2, check(directionBull ? recentSSLSweep : recentBSLSweep, directionBull ? "SSL Swept" : "BSL Swept", directionBull ? "Need SSL" : "Need BSL"), text_color = (recentSSLSweep or recentBSLSweep) ? bullColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 3, "Displacement", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 3, check(dashboardDisplacement, "Strong", directionBull ? "Need Bull Disp" : "Need Bear Disp"), text_color = dashboardDisplacement ? bullColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 4, "Structure", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 4, latestStructureEvent, text_color = str.contains(latestStructureEvent, "Bullish") ? bullColor : str.contains(latestStructureEvent, "Bearish") ? bearColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 5, "Zig Zag", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 5, zigZagDashboardText, text_color = zigZagDashboardColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 6, "OB / FVG", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 6, (obActive ? zoneText : "OB ...") + " / " + (fvgActive ? fvgText : "FVG ..."), text_color = obActive ? (activeBullish ? bullColor : bearColor) : neutralColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 7, "Retest", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 7, executionRetestText, text_color = executionRetestText == "No Retest" ? neutralColor : marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 8, "Execution", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 8, executionStatusText + " / " + executionEntryLockText, text_color = executionStatusText == "Triggered" ? bullColor : executionStatusText == "Stand Down" ? bearColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 9, "Entry Permission", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 9, executionEntryPermissionText, text_color = executionEntryPermissionColor, bgcolor = panelColor)

            table.cell(dash, 0, 10, "Protected Guard", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 10, sniperProtectedGuardText, text_color = sniperProtectedGuardColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 11, "Sniper Sweep", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 11, sniperInternalSweepText, text_color = sniperInternalSweepColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 12, "HTF Context", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 12, sniperHTFContextText, text_color = sniperHTFContextColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 13, "OTE / HTF", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 13, (dashboardOTE ? "OTE OK" : "OTE ...") + " / " + biasText, text_color = dashboardOTE ? bullColor : neutralColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 14, "Objective", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 14, currentObjectiveText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 15, "Next Event", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 15, expectedNextEventText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 16, "Briefing", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 16, marketBriefingText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.small)

        else if isTradeManagement
            table.cell(dash, 0, 0, "ICE GENESIS", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 1, 0, "v1.0 ZZ PR3", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 0, 1, "TRADE MANAGEMENT", text_color = color.white, bgcolor = color.new(color.black, 0))
            table.cell(dash, 1, 1, lastPlanDirection, text_color = lastPlanDirection == "LONG" ? bullColor : lastPlanDirection == "SHORT" ? bearColor : neutralColor, bgcolor = color.new(color.black, 0), text_size = size.large)

            table.cell(dash, 0, 2, "Decision", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 2, lastDecision, text_color = decisionColor, bgcolor = panelColor, text_size = size.large)

            table.cell(dash, 0, 3, "Entry / Stop", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 3, dashboardEntryStop, text_color = color.white, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 4, "Target / RR", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 4, dashboardTargetRR, text_color = bullColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 5, "Score / Grade", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 5, compactScore, text_color = lastScore >= minimumScore ? bullColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 6, "Objective", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 6, currentObjectiveText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 7, "Next Event", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 7, expectedNextEventText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 8, "Briefing", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 8, marketBriefingText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.small)

        else if isFull
            table.cell(dash, 0, 0, "ICE GENESIS", text_color = color.white, bgcolor = panelColor, text_size = size.small)
            table.cell(dash, 1, 0, "v1.0 ZZ PR3", text_color = color.white, bgcolor = panelColor, text_size = size.small)

            table.cell(dash, 0, 1, "FULL DASHBOARD", text_color = color.white, bgcolor = color.new(color.black, 0))
            table.cell(dash, 1, 1, "", bgcolor = color.new(color.black, 0))

            table.cell(dash, 0, 2, "Direction", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 2, marketDirectionText, text_color = marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 3, "Zig Zag", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 3, zigZagDashboardText, text_color = zigZagDashboardColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 4, "Narrative", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 4, institutionalNarrativeText, text_color = marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 5, "Decision", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 5, lastDecision, text_color = decisionColor, bgcolor = panelColor, text_size = size.large)

            table.cell(dash, 0, 6, "Retest", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 6, executionRetestText, text_color = executionRetestText == "No Retest" ? neutralColor : marketDirectionColor, bgcolor = panelColor)

            table.cell(dash, 0, 7, "Execution", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 7, executionStatusText + " / " + executionEntryLockText, text_color = executionStatusText == "Triggered" ? bullColor : executionStatusText == "Stand Down" ? bearColor : neutralColor, bgcolor = panelColor)

            table.cell(dash, 0, 8, "Entry Permission", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 8, executionEntryPermissionText, text_color = executionEntryPermissionColor, bgcolor = panelColor)

            table.cell(dash, 0, 9, "Protected Guard", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 9, sniperProtectedGuardText, text_color = sniperProtectedGuardColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 10, "Sniper Sweep", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 10, sniperInternalSweepText, text_color = sniperInternalSweepColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 11, "HTF Context", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 11, sniperHTFContextText, text_color = sniperHTFContextColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 12, "Objective", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 12, currentObjectiveText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)

            table.cell(dash, 0, 13, "Next Event", text_color = neutralColor, bgcolor = panelColor)
            table.cell(dash, 1, 13, expectedNextEventText, text_color = marketDirectionColor, bgcolor = panelColor, text_size = size.tiny)
 
//=============================================================================
// 16. ALERTS
//=============================================================================
alertcondition(buySideSweep, "ICE Genesis: Buy-side liquidity swept", "ICE Genesis detected a buy-side liquidity sweep on {{ticker}} {{interval}}.")
alertcondition(sellSideSweep, "ICE Genesis: Sell-side liquidity swept", "ICE Genesis detected a sell-side liquidity sweep on {{ticker}} {{interval}}.")
alertcondition(bullMSS, "ICE Genesis: Bullish CHoCH", "ICE Genesis detected a bullish change of character on {{ticker}} {{interval}}.")
alertcondition(bearMSS, "ICE Genesis: Bearish CHoCH", "ICE Genesis detected a bearish change of character on {{ticker}} {{interval}}.")
alertcondition(bullExternalBOS, "ICE Genesis: Bullish external BOS", "ICE Genesis detected a bullish external break of structure on {{ticker}} {{interval}}.")
alertcondition(bearExternalBOS, "ICE Genesis: Bearish external BOS", "ICE Genesis detected a bearish external break of structure on {{ticker}} {{interval}}.")
alertcondition(bullOBZoneSignal, "ICE Genesis: Bullish highlighted OB zone", "ICE Genesis highlighted a bullish order-block zone on {{ticker}} {{interval}}.")
alertcondition(bearOBZoneSignal, "ICE Genesis: Bearish highlighted OB zone", "ICE Genesis highlighted a bearish order-block zone on {{ticker}} {{interval}}.")
alertcondition(bullStructureEvent and bullInstitutionalOB, "ICE Genesis: Bullish institutional OB", "ICE Genesis validated a bullish institutional order block on {{ticker}} {{interval}}.")
alertcondition(bearStructureEvent and bearInstitutionalOB, "ICE Genesis: Bearish institutional OB", "ICE Genesis validated a bearish institutional order block on {{ticker}} {{interval}}.")
alertcondition(decisionLongSignal, "ICE Genesis: Decision BUY", "ICE Genesis Decision Engine confirmed a BUY setup on {{ticker}} {{interval}}.")
alertcondition(decisionShortSignal, "ICE Genesis: Decision SELL", "ICE Genesis Decision Engine confirmed a SELL setup on {{ticker}} {{interval}}.")
alertcondition(executionBullEntryTriggerSignal, "ICE Genesis: Bullish confirmation-break entry trigger", "ICE Genesis Execution Engine confirmed a bullish confirmation-break entry trigger on {{ticker}} {{interval}}.")
alertcondition(executionBearEntryTriggerSignal, "ICE Genesis: Bearish confirmation-break entry trigger", "ICE Genesis Execution Engine confirmed a bearish confirmation-break entry trigger on {{ticker}} {{interval}}.")
alertcondition(sniperBearProtectedHighSweptNow, "ICE Genesis: Bearish protected high swept", "ICE Genesis Sniper Model detected a bearish protected high sweep / reset on {{ticker}} {{interval}}.")
alertcondition(sniperBullProtectedLowSweptNow, "ICE Genesis: Bullish protected low swept", "ICE Genesis Sniper Model detected a bullish protected low sweep / reset on {{ticker}} {{interval}}.")
